#  `kit status [path…]`
#
#    kit status                  the repository the shell is in
#    kit status ~/a ~/s/kit      one report per path, in the order given
#
#  A directory that is not a repository is looked into one level down.

use fs path
use ./git
use ./render

#  The repositories one level below `dir`, in name order; [] when there are none.

childRepos = (dir) ->

    entries = []
    try
        entries = fs.readdirSync dir, withFileTypes: true
    catch
        # unreadable, or not a directory at all
        return []

    out = []

    for entry in entries
        if entry.name.startsWith '.' then continue
        child = path.join(dir, entry.name)
        if fs.existsSync(path.join(child, '.git')) then out.push child

    out.sort()

status = (args=[], io=console, opt={}) ->

    t = opt.theme
    given = if args.length > 0 then args else ['.']
    dirs = given.map((a) -> path.resolve(a))
    code = 0

    report = (dir) ->

        res = git.collectStatus dir

        if res.error
            detail = res.error.stderr.trim()
            io.error 'kit status: ' + (if empty detail then 'git status failed' else detail)
            if code == 0 then code = res.error.code
            return

        out = render.renderStatus res.data, {theme: t}
        if out then io.log out

    for dir in dirs

        label = render.abbreviateHome dir

        if not fs.existsSync dir
            io.error "kit status: #{label}: no such directory"
            code = 128
            continue

        problem = git.repoProblem dir

        if problem

            children = childRepos dir

            if children.length > 0
                for child in children
                    report child
                continue

            io.error "kit status: #{label}: #{problem}"
            code = 128
            continue

        report dir

    code

export
    childRepos: childRepos
    status: status