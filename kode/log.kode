###
███       ███████    ███████
███      ███   ███  ███
███      ███   ███  ███  ████
███      ███   ███  ███   ███
███████   ███████    ███████
###

# `kit log [-l|--long] [-f|--files] [n] [path…]`
#
#    kit log          one line per commit, truncated to the terminal width
#    kit log 10       the 10 most recent commits
#    kit log -l       the full message, wrapped under the subject column
#    kit log -f       the files every commit touched, under the message
#    kit log -l 10    both
#
# The arguments behind -f are the paths the listing is limited to, and they
# are the ones `kit diff` takes: a file type such as kode or .kode, or the
# name of a file.

use ./git
use ./render
use ./diff
use ./theme

parseArgs = (args) ->

    long = false
    files = false
    numbers = []
    paths = []
    filtering = false

    for arg in args

        if arg in ['-l' '--long']
            long = true
            continue

        if arg in ['-f' '--files']
            files = true
            filtering = true
            continue

        #  The count is the log's, wherever it stands.

        if (/^\d+$/).test arg
            numbers.push arg
            continue

        #  Everything behind -f belongs to the diff: the files the listing is
        #  limited to.

        if filtering
            paths.push arg
            continue

        ⮐ ok: false, message: "'#{arg}' is not a commit count (try: kit log 10)"

    if numbers.length > 1
        ⮐ ok: false, message: "expected at most one commit count, got #{numbers.length}"

    ok: true
    count: if numbers.length then Number(numbers[0]) else null
    long: long
    files: files
    paths: paths

#  Terminal width in columns, or a sane fallback.

terminalWidth = (out=process.stdout) ->

    cols = out?.columns
    if Number.isInteger(cols) and cols > 0 then ⮐ cols
    render.DEFAULT_WIDTH

#  The paths the files are limited to, as the diff command has them.

filterPaths = (args) ->

    parsed = diff.parseArgs(args, git.isCommit)

    if not parsed.ok then ⮐ {ok: false, message: parsed.message}

    #  A commit is not a path: the log shows every commit in it, so there is
    #  no one commit to name.

    if parsed.target
        label = if parsed.target.number? then "-#{parsed.target.number}" else parsed.target.rev
        ⮐ {ok: false, message: "'#{label}' is a commit, not a path"}

    {ok: true, paths: parsed.paths}

log = (args, io=console, env={}) ->

    if not git.inRepo()
        io.error 'kit log: not a git repository'
        return 128

    parsed = parseArgs args

    if not parsed.ok
        io.error 'kit log: ' + parsed.message
        return 1

    paths = []

    if parsed.paths.length > 0

        p = filterPaths(parsed.paths)

        if not p.ok
            io.error 'kit log: ' + p.message
            return 1

        paths = p.paths

    t = env.theme ? theme.theme

    res = git.collectLog parsed.count, {
        long: parsed.long
        files: parsed.files
        paths: paths
    }

    if res.error
        detail = res.error.stderr.trim()
        io.error 'kit log: ' + (if empty detail then 'git log failed' else detail)
        return res.error.code

    width = env.width ? terminalWidth(env.stream ? process.stdout)
    out = render.renderLog res.data, {width, long: parsed.long, theme: t}

    if out then io.log out
    0

export
    parseArgs: parseArgs
    terminalWidth: terminalWidth
    filterPaths: filterPaths
    log: log