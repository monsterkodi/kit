###
 ███████   ███  █████████
███        ███     ███
███  ████  ███     ███
███   ███  ███     ███
 ███████   ███     ███
###

#  Runs git and returns plain data plus the exit code. Nothing here formats
#  output for humans; that is render.kode's job. Keeping the seam sharp is what
#  lets the renderers be tested without a repository.
#
#  Porcelain is used everywhere, never human-readable prose.

use child_process

MAXBUFFER = 64 * 1024 * 1024

#  GIT_OPTIONAL_LOCKS is deliberately NOT set to 0 here. It makes git skip the
#  index refresh/lock, which is right for read-only commands like log but wrong
#  when a mutating `git add` is immediately followed by a status read: the status
#  then observes a stale index and reports nothing staged.

gitEnv = -> Object.assign {}, process.env, {GIT_PAGER: 'cat', PAGER: 'cat'}

run = (args, opt={}) ->

    opts =
        encoding: 'utf8'
        maxBuffer: MAXBUFFER
        env: gitEnv()

    opts = Object.assign opts, opt

    r = child_process.spawnSync 'git', args, opts

    if r.error
        ⮐ code: 1, ok: false, stdout: '', stderr: String(r.error.message)

    ⮐ code: r.status ? 1, ok: r.status == 0, stdout: r.stdout ? '', stderr: r.stderr ? ''

capture = (args) ->

    opts =
        encoding: 'utf8'
        maxBuffer: MAXBUFFER
        env: gitEnv()

    child_process.execFileSync 'git', args, opts

#  Run git with the terminal attached: the output goes straight to the pager
#  and the diff viewer the user has set up, not through kit.
#
#  The PAGER overrides of gitEnv are left off on purpose. They exist to keep
#  the output of the other commands out of a pager, and this command is the
#  one that wants it.

runAttached = (args) ->

    r = child_process.spawnSync 'git', args, {stdio: 'inherit'}

    r.status ? 1

#  True when the token names a commit: a ref, a hash, HEAD~2 and the like.
#  A path is not a commit, and a name that is neither is a path as well.

isCommit = (token) ->

    r = run(['rev-parse', '--verify', '--quiet', "#{token}^{commit}"])

    r.ok

#  The hash of the commit that is n commits back from HEAD: n = 1 is the last
#  commit, n = 2 the one before it. Empty when the history is not that long.

commitAt = (n) ->

    rev = if n == 1 then 'HEAD' else "HEAD~#{n - 1}"

    r = run(['rev-parse', '--verify', '--quiet', "#{rev}^{commit}"])

    if r.ok then r.stdout.trim() else ''

at = (dir) -> if dir then {cwd: dir} else {}

repoProblem = (dir) ->

    r = run(['rev-parse', '--is-inside-work-tree'], at(dir))
    if not r.ok then ⮐ 'not a git repository'
    if r.stdout.trim() != 'true' then ⮐ 'no work tree'
    ''

inRepo = (dir) -> repoProblem(dir) == ''

###
 ███████  █████████   ███████   █████████  ███   ███   ███████        ███   ███  █████ 
███          ███     ███   ███     ███     ███   ███  ███             ███   ███     ███
███████      ███     █████████     ███     ███   ███  ███████          ███ ███     ███ 
     ███     ███     ███   ███     ███     ███   ███       ███           ███      ███  
███████      ███     ███   ███     ███      ███████   ███████             █      ██████
###

#  Parse `git status --porcelain=v2 -z -b -unormal` into structured data.

parseStatusV2 = (raw) ->

    out =
        branch: null
        upstream: null
        ahead: 0
        behind: 0
        detached: false
        staged: []
        unstaged: []
        untracked: []

    fields = raw.split '\0'

    for i in 0...fields.length

        rec = fields[i]
        if empty rec then continue

        if rec.startsWith '# branch.oid'
            out.oid = rec.slice('# branch.oid '.length).trim()
            continue

        if rec.startsWith '# branch.head'
            head = rec.slice('# branch.head '.length).trim()
            out.detached = head == '(detached)'
            out.branch = if out.detached then null else head
            continue

        if rec.startsWith '# branch.upstream'
            out.upstream = rec.slice('# branch.upstream '.length).trim()
            continue

        if rec.startsWith '# branch.ab'
            m = rec.slice('# branch.ab '.length).trim().match(/^\+(\d+)\x20-(\d+)$/)
            if m
                out.ahead = Number(m[1])
                out.behind = Number(m[2])
            continue

        if rec.startsWith '#' then continue # any other header

        if rec.startsWith '?'
            out.untracked.push path: rec.slice(2), code: '?'
            continue

        if rec.startsWith '!' then continue # ignored: not shown, by design

        kind = rec[0]
        rest = rec.slice 2

        if kind in ['1' 'u']

            parts = rest.split ' '
            xy = parts[0]

            path = parts.slice(7).join ' '
            x = xy[0]
            y = xy[1]

            if x != '.' then out.staged.push {path: path, code: x}
            if y != '.' then out.unstaged.push {path: path, code: y}
            continue

        if kind == '2'

            parts = rest.split ' '
            xy = parts[0]
            path = parts.slice(8).join ' '
            orig = fields[++i] ? '' # the rename/copy source path
            x = xy[0]
            y = xy[1]

            if x != '.' then out.staged.push {path, code: x, orig}
            if y != '.' then out.unstaged.push {path, code: y, orig}
            continue

    out

#  The given directory's path relative to the repository root, as a prefix
#  ending in "/", or '' at the root. Empty outside a repository.

showPrefix = (dir) ->

    r = run(['rev-parse', '--show-prefix'], at(dir))
    if not r.ok then ⮐ ''
    r.stdout.trim()

#  The absolute path of the repository root containing `dir`, or '' when there is none.

showToplevel = (dir) ->

    r = run(['rev-parse', '--show-toplevel'], at(dir))
    if not r.ok then ⮐ ''
    r.stdout.trim()

#  Rewrite repo-root-absolute paths to be relative to the current directory,
#  the way `git status` does when run from a subdirectory.

relativise = (data, prefix) ->

    if not prefix then ⮐ data

    out = Object.assign {}, data

    fix = (items) ->

        items.map (item) ->

            rel = relativeTo(item.path, prefix)
            if rel == item.path then ⮐ item

            next = Object.assign {}, item, {path: rel}
            delete next.orig
            next

    out.staged = fix data.staged
    out.unstaged = fix data.unstaged
    out.untracked = fix data.untracked
    out

#  Make a repository-root-relative path relative to `prefix`

relativeTo = (path, prefix) ->

    if not prefix then ⮐ path
    if path.startsWith prefix then ⮐ path.slice prefix.length

    #  prefix always ends in '/', so drop it first: slicing 'lib/' at its last
    #  '/' would leave 'lib' rather than the directory above it.

    acc = prefix.replace(/\/$/, '') # 'lib/' -> 'lib'
    up  = 0

    while true

        if acc != '' and path.startsWith(acc + '/')
            ⮐ '../'.repeat(up) + path.slice(acc.length + 1)

        cut = acc.lastIndexOf '/'
        acc = if cut == -1 then '' else acc.slice(0, cut)
        up += 1

        if acc == '' then ⮐ '../'.repeat(up) + path

collectStatus = (dir) ->

    r = run(['status', '--porcelain=v2', '-z', '-b', '-unormal'], at(dir))
    if not r.ok then ⮐ error: r, data: null

    data = relativise(parseStatusV2(r.stdout), showPrefix(dir))
    data.root = showToplevel dir

    error: null, data: data

stagedCount = ->

    r = run(['diff', '--cached', '--name-only'])
    if not r.ok then ⮐ 0
    r.stdout.split('\n').filter(Boolean).length

LOG_DATE = 'format-local:%b %e %H:%M'

LOG_FORMAT_SHORT = '%x00%h%x00%ad%x00%an%x00%s%x00'
LOG_FORMAT_LONG  = '%x00%h%x00%ad%x00%an%x00%B%x00'

#  The markers that tell the extra blocks of a commit apart from its message.
#  They are printed by the format, so they come before the block git writes
#  after it: the file list, the patch.

LOG_MARK_FILES = '<<files>>'
LOG_MARK_PATCH = '<<patch>>'

LOG_STRIDE = 5

###
 ███████   ███  █████████        ███       ███████    ███████ 
███        ███     ███           ███      ███   ███  ███      
███  ████  ███     ███           ███      ███   ███  ███  ████
███   ███  ███     ███           ███      ███   ███  ███   ███
 ███████   ███     ███           ███████   ███████    ███████ 
###

#  Parse `git log` output produced by the formats above.
#
#  With the file list asked for, the fifth field of a record is the list of
#  files the commit touched, behind its marker.

parseLog = (raw) ->

    fields = raw.split '\0'
    out = []

    #  Field 0 is the empty marker from the leading %x00; from index 1 the record
    #  repeats every LOG_STRIDE fields: hash, date, name, message, "\n".

    i = 1
    while i + 4 <= fields.length

        [hash, date, name, message] = fields.slice i, i + 4

        if valid hash

            text = String(message ? '').replace(/\s+$/, '')

            record =
                hash: hash.trim()
                date: date.trim()
                name: name.trim()
                subject: text
                body: text

            block = fields[i + 4] ? ''

            if block.startsWith LOG_MARK_FILES
                record.files = parseFiles block.slice(LOG_MARK_FILES.length)

            out.push record

        i += LOG_STRIDE

    out

#  The files a commit touched: the status letter and the path of each of them.
#
#  A rename is written as "R100\told\tnew": the path is the new name and the
#  old one comes along as the origin, the way kit status shows it.

parseFiles = (block) ->

    out = []

    for line in String(block ? '').split('\n')

        if line == '' then continue

        m = line.match(/^([A-Z])\d*\t(.+)$/)
        if not m then continue

        parts = m[2].split('\t')

        out.push
            code: m[1]
            path: parts[parts.length - 1]
            orig: if parts.length > 1 then parts[0] else null

    out

#  The patches of the commits, as git writes them: one call, the commits in
#  the order the log has them.

LOG_FORMAT_PATCH = '%x00%h%x00' + LOG_MARK_PATCH

collectPatches = (count=null, paths=[], opt={}) ->

    #  --cc is what git show does for a merge: the combined diff, the one that
    #  says what the merge itself decided.

    args = ['log', '-p', '--cc', "--format=#{LOG_FORMAT_PATCH}", '--reverse']

    if opt.colour then args.push '--color=always'

    if count != null then args.push '-n', String(count)

    if paths.length > 0 then args = args.concat(['--']).concat(paths)

    r = run args
    if not r.ok then ⮐ {error: r, data: null}

    {error: null, data: parsePatches(r.stdout)}

parsePatches = (raw) ->

    out = {}
    fields = raw.split '\0'

    #  The records repeat every two fields: the hash, and the patch behind its
    #  marker.

    i = 1
    while i + 1 < fields.length

        hash = fields[i].trim()
        block = fields[i + 1] ? ''

        if valid hash and block.startsWith LOG_MARK_PATCH
            out[hash] = block.slice(LOG_MARK_PATCH.length).replace(/^\n+|\n+$/g, '')

        i += 2

    out

#  True when the repository has no commits yet (an unborn HEAD).

hasCommits = -> run(['rev-parse', '--verify', 'HEAD']).ok

#  Collect commit history
#    displays commits from oldest to newest
#    defaults to one line per commit
#    option long=true displays the full message
#    option files=true adds the files every commit touched
#    option patch=true adds the patch of every commit, limited to the paths

collectLog = (count=null, opt={}) ->

    long = opt.long ? false
    files = opt.files ? false
    patch = opt.patch ? false
    paths = opt.paths ? []

    if not hasCommits() then ⮐ {error: null, data: []}

    format = if long then LOG_FORMAT_LONG else LOG_FORMAT_SHORT

    if files then format = "#{format}#{LOG_MARK_FILES}"

    args = ['log', "--format=#{format}", "--date=#{LOG_DATE}", '--reverse']

    if files then args.push '--name-status'

    if count != null then args.push '-n', String(count)

    r = run args
    if not r.ok then ⮐ {error: r, data: null}

    data = parseLog(r.stdout)

    if patch

        p = collectPatches(count, paths, {colour: opt.colour ? false})

        if p.error then ⮐ {error: p.error, data: null}

        for c in data
            c.patch = p.data[c.hash] ? ''

    error: null, data: data

export
    run: run
    capture: capture
    runAttached: runAttached
    isCommit: isCommit
    commitAt: commitAt
    repoProblem: repoProblem
    inRepo: inRepo
    parseStatusV2: parseStatusV2
    showPrefix: showPrefix
    showToplevel: showToplevel
    relativise: relativise
    relativeTo: relativeTo
    collectStatus: collectStatus
    stagedCount: stagedCount
    hasCommits: hasCommits
    collectLog: collectLog
    collectPatches: collectPatches
    parseLog: parseLog
    parseFiles: parseFiles
    parsePatches: parsePatches
    LOG_DATE: LOG_DATE