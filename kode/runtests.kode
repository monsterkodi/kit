#  the test runner.
#
#  `pnpm test` runs this file (js/runtests.js): every module in js/test is
#  imported and handed to the ked tester, which walks the sections and
#  compares what they compare.  kk -t runs the same modules through the same
#  tester, but it cannot tell a failure from a run that worked, so this file
#  is the one that exits with a code.
#
#  usage
#
#      node js/runtests.js                 every test module
#      node js/runtests.js brief           the sections are not logged
#      node js/runtests.js silent          neither sections nor modules are logged
#      node js/runtests.js js/test/log.js  one test file

use fs path
use ../../ked/js/kode ◆ tester

DIR = path.join(◆dir, 'test')

lastArg = process.argv[-1]

if lastArg == 'brief'

    tester.logSections = false

else if lastArg == 'silent'

    tester.logSections = false
    tester.logModules = false

fail = false

if lastArg not in ['brief' 'silent'] and lastArg != ◆file

    #  one file, named the way it is named from the project root

    file = path.join(◆dir, '..', lastArg)

    test = ○ import(file)

    fail = not (○ tester.test(test.default))

else

    for name in fs.readdirSync(DIR)

        continue if not name.endsWith('.js')

        test = ○ import(path.join(DIR, name))

        #  the helpers are modules too, but they have no sections to run

        continue if not test.default?._test_

        fail = fail or not (○ tester.test(test.default))

tester.summarize()

if fail
    process.exit 1
