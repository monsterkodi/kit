#  `kit log` width handling and the --long layout.
#
#  All pure: renderLog takes the width as data, so no TTY and no git are needed.

use ../render
use ../log
use ./helpers ▪ matches notMatches

plain = (s) -> s.replace(/\u001b\[[0-9;]*m/g, '')
widths = (s) -> plain(s).split('\n').map((l) -> render.displayWidth l)

LONG_SUBJECT = 'AGENTS.md: replace rules satisfiable by sounding thoughtful with checkable ones'

commit = (over={}) ->

    base =
        hash: 'f9c98c7'
        date: 'Oct  1 04:32'
        name: 'opencode'
        subject: LONG_SUBJECT
        body: LONG_SUBJECT

    Object.assign base, over

widest = (s) -> Math.max.apply null, widths(s)

▸ width

    ▸ PREFIX_WIDTH matches the real rendered prefix

        render.PREFIX_WIDTH ▸ 30

        line = plain render.renderLog([commit({subject: 'x'})], {width: 100})

        render.displayWidth(line) ▸ render.PREFIX_WIDTH + 1

    ▸ a short subject is left untouched

        out = plain render.renderLog([commit({subject: 'short one'})], {width: 100})

        matches out, /short\x20one$/
        not out.includes('…') ▸ yes

    ▸ a long subject is truncated to the width

        out = plain render.renderLog([commit()], {width: 100})

        widest(out) ▸ 100
        out.includes('…') ▸ yes
        out.includes('AGENTS.md:') ▸ yes

    ▸ output never exceeds the width when the budget allows

        for w in [70 80 90 100 111 120 160 190]
            out = plain render.renderLog([commit()], {width: w})
            widest(out) <= w ▸ yes

    ▸ below the minimum message width, the message is left long rather than mangled

        render.NARROW_WIDTH ▸ 60
        render.MIN_MESSAGE_WIDTH ▸ 40

        out = plain render.renderLog([commit()], {width: 65})

        widest(out) ▸ render.PREFIX_WIDTH + LONG_SUBJECT.length
        not out.includes('…') ▸ yes
        out.includes(LONG_SUBJECT) ▸ yes

    ▸ the narrow layout never overflows, even at absurd widths

        for w in [30 40 50 59]
            out = plain render.renderLog([commit()], {width: w})
            widest(out) <= w ▸ yes

    ▸ below NARROW_WIDTH the message goes on its own line

        out = plain render.renderLog([commit({subject: 'a message here'})], {width: 50})
        lines = out.split '\n'

        lines.length ▸ 2
        matches lines[0], /^f9c98c7\x20Oct\x20{2}1\x2004:32\x20opencode$/
        matches lines[1], /^\x20{2}a\x20message\x20here$/

    ▸ the narrow layout still truncates a long message

        out = plain render.renderLog([commit()], {width: 50})

        out.includes('…') ▸ yes
        widest(out) <= 50 ▸ yes

▸ truncate

    ▸ leaves short text alone and marks the cut otherwise

        render.truncate('short', 20) ▸ 'short'

        cut = render.truncate 'abcdefghij', 5

        cut ▸ 'abcd…'
        render.displayWidth(cut) ▸ 5

    ▸ the ellipsis is a single glyph, not three dots

        render.truncate('abcdefghij', 5).endsWith('…') ▸ yes
        not render.truncate('abcdefghij', 5).endsWith('...') ▸ yes

    ▸ displayWidth counts an em-dash as one column, not two bytes

        render.displayWidth('a—b') ▸ 3
        render.displayWidth('…') ▸ 1
        render.displayWidth('') ▸ 0

    ▸ truncation accounts for multi-byte characters

        t = render.truncate 'aa—bb—cc—dd', 6

        render.displayWidth(t) ▸ 6

▸ wrap

    ▸ breaks on spaces and respects the width

        lines = render.wrap 'the quick brown fox jumps over the lazy dog', 15

        for l in lines
            render.displayWidth(l) <= 15 ▸ yes

        lines.join(' ') ▸ 'the quick brown fox jumps over the lazy dog'

    ▸ preserves blank lines between paragraphs

        lines = render.wrap 'one\n\ntwo', 20

        lines ▸ ['one' '' 'two']

    ▸ hard-splits a word longer than the width

        lines = render.wrap(('x'.repeat(25)), 10)

        lines.length ▸ 3
        for l in lines
            render.displayWidth(l) <= 10 ▸ yes
        lines.join('').length ▸ 25

▸ long

    ▸ --long indents continuation lines under the subject column

        out = plain render.renderLog([commit()], {width: 80, long: true})
        lines = out.split '\n'

        lines.length > 1 ▸ yes

        for l in lines.slice 1
            l.startsWith(' '.repeat(render.PREFIX_WIDTH)) ▸ yes

        widest(out) <= 80 ▸ yes

    ▸ --long keeps a blank paragraph break, without trailing spaces on it

        body = 'subject\n\nfirst para\n\nsecond para'
        out = plain render.renderLog([commit({subject: body, body})], {width: 80, long: true})

        out.includes('\n\n') ▸ yes

        for line in out.split '\n'
            line ▸ line.replace(/\s+$/, '')

    ▸ --long shows more than the subject alone

        body = 'the subject\n\nA body paragraph that git log --oneline would hide.'
        short = plain render.renderLog([commit({subject: body, body})], {width: 80})
        long = plain render.renderLog([commit({subject: body, body})], {width: 80, long: true})

        long.includes('A body paragraph') ▸ yes
        not short.includes('A body paragraph') ▸ yes

    ▸ a body is set off from the next commit by a blank line

        body = 'the subject\n\nthe body of the message'
        out = plain render.renderLog([commit({subject: body, body}), commit({hash: 'def5678'})], {width: 80, long: true})
        lines = out.split '\n'

        lines[3] ▸ ''
        matches lines[4], /^def5678\x20/

    ▸ a message without a body gets no blank line

        out = plain render.renderLog([commit({subject: 'a message', body: 'a message'}), commit({hash: 'def5678', subject: 'another', body: 'another'})], {width: 80, long: true})

        out.split('\n').length ▸ 2

    ▸ the short layout leaves no blank line behind

        body = 'the subject\n\nthe body of the message'
        out = plain render.renderLog([commit({subject: body, body}), commit({hash: 'def5678'})], {width: 80})

        out.split('\n').length ▸ 2

    ▸ the last body is not followed by a blank line

        body = 'the subject\n\nthe body of the message'
        out = plain render.renderLog([commit({subject: body, body})], {width: 80, long: true})

        out.split('\n').length ▸ 3
        out.endsWith('\n') ▸ no

▸ the files of a commit

    ▸ they are listed under the subject column

        c = commit({files: [{code: 'A', path: 'src/new.mjs'}, {code: 'M', path: 'README.md'}]})
        out = plain render.renderLog([c], {width: 80})
        lines = out.split '\n'

        lines.length ▸ 4
        lines[1] ▸ ''
        lines[2] ▸ ' '.repeat(render.PREFIX_WIDTH) + 'A src/new.mjs'
        lines[3] ▸ ' '.repeat(render.PREFIX_WIDTH) + 'M README.md'

    ▸ a rename keeps the name it came from

        c = commit({files: [{code: 'R', path: 'new.txt', orig: 'old.txt'}]})
        out = plain render.renderLog([c], {width: 80})

        matches out, /R\x20new\.txt/
        matches out, /old\.txt/

    ▸ they are set off from the next commit by a blank line

        c = commit({files: [{code: 'A', path: 'a.mjs'}]})
        out = plain render.renderLog([c, commit({hash: 'def5678'})], {width: 80})
        lines = out.split '\n'

        lines[3] ▸ ''
        matches lines[4], /^def5678\x20/

    ▸ a commit without files has none

        out = plain render.renderLog([commit()], {width: 80})

        out.split('\n').length ▸ 1

    ▸ the listing is below the body of a long message

        body = 'the subject\n\nthe body of the message'
        c = commit({subject: body, body, files: [{code: 'A', path: 'a.mjs'}]})
        out = plain render.renderLog([c], {width: 80, long: true})
        lines = out.split '\n'

        lines[2] ▸ ' '.repeat(render.PREFIX_WIDTH) + 'the body of the message'
        lines[3] ▸ ''
        lines[4] ▸ ' '.repeat(render.PREFIX_WIDTH) + 'A a.mjs'

▸ parseArgs

    ▸ no arguments is short mode, whole history

        log.parseArgs([]) ▸ {ok: true, count: null, long: false, files: false, paths: []}

    ▸ a bare number is a commit count

        log.parseArgs(['10']) ▸ {ok: true, count: 10, long: false, files: false, paths: []}
        log.parseArgs(['0']) ▸ {ok: true, count: 0, long: false, files: false, paths: []}

    ▸ -l and --long both mean long mode

        log.parseArgs(['-l']) ▸ {ok: true, count: null, long: true, files: false, paths: []}
        log.parseArgs(['--long']) ▸ {ok: true, count: null, long: true, files: false, paths: []}

    ▸ the flag and a count combine in either order

        log.parseArgs(['-l', '5']) ▸ {ok: true, count: 5, long: true, files: false, paths: []}
        log.parseArgs(['5', '-l']) ▸ {ok: true, count: 5, long: true, files: false, paths: []}
        log.parseArgs(['5', '--long']) ▸ {ok: true, count: 5, long: true, files: false, paths: []}

    ▸ -f and --files ask for the files of a commit

        log.parseArgs(['-f']) ▸ {ok: true, count: null, long: false, files: true, paths: []}
        log.parseArgs(['--files']) ▸ {ok: true, count: null, long: false, files: true, paths: []}

    ▸ everything behind -f belongs to the diff

        log.parseArgs(['-f', '.kode']) ▸ {ok: true, count: null, long: false, files: true, paths: ['.kode']}
        log.parseArgs(['5', '-f', 'kode', 'src/a.mjs']) ▸ {ok: true, count: 5, long: false, files: true, paths: ['kode', 'src/a.mjs']}

    ▸ the count is the log's, wherever it stands

        log.parseArgs(['-f', '5']) ▸ {ok: true, count: 5, long: false, files: true, paths: []}
        log.parseArgs(['-f', '5', '.kode']) ▸ {ok: true, count: 5, long: false, files: true, paths: ['.kode']}

    ▸ the flags of the log are the flags of the log, wherever they stand

        log.parseArgs(['-f', '-l']) ▸ {ok: true, count: null, long: true, files: true, paths: []}

    ▸ bad arguments are rejected, not silently ignored

        for bad in [['foo'] ['-x'] ['1.5'] ['']]
            r = log.parseArgs bad
            r.ok ▸ false
            matches r.message, /not\x20a\x20commit\x20count/

    ▸ more than one count is an error

        r = log.parseArgs ['1', '2']

        r.ok ▸ false
        matches r.message, /at\x20most\x20one/

▸ terminalWidth

    ▸ uses the stream width when it is a real terminal

        log.terminalWidth({columns: 120}) ▸ 120
        log.terminalWidth({columns: 40}) ▸ 40

    ▸ falls back when the value is unusable

        for bad in [undefined null 0 -1 NaN '80']
            log.terminalWidth({columns: bad}) ▸ render.DEFAULT_WIDTH

        render.DEFAULT_WIDTH ▸ 80

▸ fitName

    ▸ still pads or crops to 8

        render.fitName('Thorsten') ▸ 'Thorsten'
        render.fitName('zoe') ▸ 'zoe     '
        render.fitName('Christopher') ▸ 'Christop'
