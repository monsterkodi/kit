###
████████   ████████  ███    ███ ██████████████   ███████
███   ███  ███    ███ ████  ███    ███    ███  ███
████████   ███    ███ ███ ██████    ███    ███  ███████
███   ███  ███    ███ ███  ███    ███    ███  ███
███   ███  ████████  ███   ███    ████████    ███████
###

#  tests command modules against real throwaway repositories.
#
#  Each test builds a temp repo, sets an identity so commit works without
#  touching the user's global git config, and asserts on real git behaviour.
#
#  Two rules the rest of the suite has already learned, both load-bearing here:
#  a regex literal may not contain a space (\x20 instead), and kode has no
#  try/finally without a catch — so every test that cleans up a temp directory
#  rethrows through an empty catch to reach its finally. The cleanup is in the
#  finally, where it was.

import test from 'node:test'
import assert from 'node:assert/strict'

import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import cp from 'node:child_process'

use ../status
use ../add
use ../commit
use ../log
use ./style

newRepo = (where) ->

    own = where == undefined
    dir = if own then fs.mkdtempSync(path.join(os.tmpdir(), 'kit-test-')) else where
    if not own then fs.mkdirSync(dir, {recursive: true})

    #  Identity must come from the environment, not -c flags: this machine has
    #  GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL exported, and they take precedence over
    #  `git -c user.name=…`. Set both so tests do not depend on ambient config.

    env = Object.assign {}, process.env, {
        GIT_AUTHOR_NAME: 'test'
        GIT_AUTHOR_EMAIL: 't@e.st'
        GIT_COMMITTER_NAME: 'test'
        GIT_COMMITTER_EMAIL: 't@e.st'
    }

    git = (args...) ->
        cp.execFileSync 'git', ['-c' 'user.email=t@e.st' '-c' 'user.name=test'].concat(args), {
            cwd: dir
            encoding: 'utf8'
            env: env
        }

    git 'init', '-q'

    #  The initial branch name is machine state, not kit's: git takes it from
    #  init.defaultBranch (this machine: main), and falls back to master when that
    #  is unset. So the name is read back from the repo rather than assumed, and
    #  tests assert against it — otherwise every branch-name assertion here breaks

    branch = git('symbolic-ref', '--short', 'HEAD').trim()
    assert.ok branch, 'git init should leave a named branch to read back'

    if own then cleanup = -> fs.rmSync(dir, {recursive: true, force: true})
    else cleanup = ->

    dir: dir
    git: git
    env: env
    branch: branch
    cleanup: cleanup

#  A capturing io that always hands the command a plain palette.
#
#  Without the palette argument these commands fall back to the default palette,
#  which is coloured whenever the environment has not forbidden it — and the suite
#  no longer sets NO_COLOR, so the runner can stay coloured. The theme is attached
#  here rather than at each of the 47 call sites, because every one of them wants
#  the same thing and the ones that did not would silently start asserting on
#  escape sequences.
#
#  The callbacks are named before the object rather than inlined: a function
#  literal inside an object literal does not lex.

sink = ->

    out = []
    err = []

    log = (s) -> out.push s
    error = (s) -> err.push s
    text = -> out.join('\n')

    out: out
    err: err
    log: log
    error: error
    text: text
    opts: {theme: style.plainTheme}

withCwd = (dir, fn) ->

    prev = process.cwd()
    process.chdir dir

    try
        ⮐ fn()
    catch err
        throw err
    finally
        process.chdir prev

#  A repository that has somewhere to push, plus the bare origin it pushes to.
#
#  newRepo alone cannot exercise ahead/behind: a repository with no remote has no
#  upstream to compare against, so branch.ab never arrives and kit has nothing to
#  report. `other` is a second clone used to move the remote without touching
#  `local`, which is the only way to make a working tree behind rather than ahead.

withRemote = ->

    parent = fs.mkdtempSync path.join(os.tmpdir(), 'kit-remote-')
    origin = path.join parent, 'origin.git'

    fs.mkdirSync origin
    cp.execFileSync 'git', ['init' '-q' '--bare' '.'], {cwd: origin, stdio: 'pipe'}

    local = newRepo path.join(parent, 'local')
    local.git 'remote', 'add', 'origin', origin
    fs.writeFileSync path.join(local.dir, 'a.txt'), 'a\n'
    local.git 'add', '-A'
    local.git 'commit', '-qm', 'init'

    #  -u is what gives it an upstream
    local.git 'push', '-q', '-u', 'origin', local.branch

    other = ->
        dir = path.join parent, 'other'
        cp.execFileSync 'git', ['clone' '-q' origin dir], {encoding: 'utf8', env: local.env}
        git = (args...) ->
            cp.execFileSync 'git', ['-c' 'user.email=t@e.st' '-c' 'user.name=test'].concat(args), {
                cwd: dir
                encoding: 'utf8'
                env: local.env
            }
        dir: dir
        git: git

    parent: parent
    local: local
    other: other

test 'messageFor: joins words like the bash function did' ->

    assert.equal commit.messageFor(['this' 'is' 'a' 'commit' 'message']), 'this is a commit message'
    assert.equal commit.messageFor(['fix' '   the' '  thing']), 'fix    the   thing'
    assert.equal commit.messageFor([]), 'misc'
    assert.equal commit.messageFor(['']), 'misc'
    assert.equal commit.messageFor(['   ']), 'misc', 'whitespace-only collapses to the default'

test 'status: clean repo is completely silent and exits 0' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        io = sink()
        code = withCwd(r.dir, -> status.status([], io, io.opts))
        assert.equal code, 0
        assert.equal io.text(), '', 'clean repo must print nothing at all'
    catch err
        throw err
    finally
        r.cleanup()

test 'status: a clean tree in sync with its remote stays silent' ->

    w = withRemote()
    try
        io = sink()
        code = withCwd(w.local.dir, -> status.status([], io, io.opts))
        assert.equal code, 0
        assert.equal io.text(), '', 'pushed and clean is nothing to say'
    catch err
        throw err
    finally
        fs.rmSync(w.parent, {recursive: true, force: true})

test 'status: a clean tree ahead of its remote prints the header alone' ->

    w = withRemote()
    try
        fs.writeFileSync path.join(w.local.dir, 'b.txt'), 'b\n'
        w.local.git 'add', '-A'
        w.local.git 'commit', '-qm', 'unpushed'

        io = sink()
        code = withCwd(w.local.dir, -> status.status([], io, io.opts))
        assert.equal code, 0, 'unpushed commits are not a failure'

        out = style.plain io.text()

        assert.equal out.split('\n').length, 1, 'the header, and nothing after it'
        assert.match out, style.headerOf(w.local.dir, "#{w.local.branch} ↑1")
    catch err
        throw err
    finally
        fs.rmSync(w.parent, {recursive: true, force: true})

test 'status: a clean tree behind its remote prints the header alone' ->

    w = withRemote()
    try
        theirs = w.other()
        fs.writeFileSync path.join(theirs.dir, 'b.txt'), 'b\n'
        theirs.git 'add', '-A'
        theirs.git 'commit', '-qm', 'theirs'
        theirs.git 'push', '-q', 'origin', w.local.branch

        #  the remote-tracking ref is what status compares against
        w.local.git 'fetch', '-q'

        io = sink()
        code = withCwd(w.local.dir, -> status.status([], io, io.opts))
        assert.equal code, 0

        out = style.plain io.text()

        assert.equal out.split('\n').length, 1
        assert.match out, style.headerOf(w.local.dir, "#{w.local.branch} ↓1")
    catch err
        throw err
    finally
        fs.rmSync(w.parent, {recursive: true, force: true})

test 'status: a remote that has never been pushed to stays silent' ->

    #  A remote is configured but no upstream ref exists, so there is nothing to
    #  be out of sync with. git emits branch.upstream and no branch.ab at all.

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        r.git 'remote', 'add', 'origin', path.join(r.dir, 'nowhere.git')

        io = sink()
        code = withCwd(r.dir, -> status.status([], io, io.opts))
        assert.equal code, 0
        assert.equal io.text(), '', 'no upstream ref means no comparison'
    catch err
        throw err
    finally
        r.cleanup()

test 'commit: nothing to commit while ahead prints the header rather than silence' ->

    w = withRemote()
    try
        fs.writeFileSync path.join(w.local.dir, 'b.txt'), 'b\n'
        w.local.git 'add', '-A'
        w.local.git 'commit', '-qm', 'unpushed'

        io = sink()
        code = withCwd(w.local.dir, -> commit.commit(['msg'], io, io.opts))
        assert.equal code, 1, 'git still has nothing to commit'
        assert.match style.plain(io.text()), style.headerOf(w.local.dir, "#{w.local.branch} ↑1")
        assert.doesNotMatch io.text(), /nothing\x20added\x20to\x20commit/
    catch err
        throw err
    finally
        fs.rmSync(w.parent, {recursive: true, force: true})

test 'status: dirty repo prints branch, sections and untracked dir collapsed' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'changed\n'
        fs.mkdirSync path.join(r.dir, 'build', 'deep'), {recursive: true}
        fs.writeFileSync path.join(r.dir, 'build', 'deep', 'x.txt'), 'x\n'

        io = sink()
        code = withCwd(r.dir, -> status.status([], io, io.opts))
        assert.equal code, 0
        assert.match io.text(), style.headerOf(r.dir, r.branch)
        assert.match io.text(), style.headingOf 'unstaged'
        assert.match io.text(), style.headingOf 'untracked'
        assert.match io.text(), /\?\x20build\//, 'untracked dir should collapse to one line'
        assert.doesNotMatch io.text(), /build\/deep\/x\.txt/, 'nested file should not be listed'
    catch err
        throw err
    finally
        r.cleanup()

test 'add: stages new files (the -A vs . behaviour) and reports them' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.writeFileSync path.join(r.dir, 'new.txt'), 'n\n'

        io = sink()
        withCwd(r.dir, -> add.add([], io, io.opts))

        staged = r.git('diff', '--cached', '--name-only')

        assert.match staged, /new\.txt/, 'git add . must stage a brand-new file'
        assert.match io.text(), /A\x20new\.txt/, 'add should report what it staged'
    catch err
        throw err
    finally
        r.cleanup()

test 'add: explicit paths are forwarded' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        fs.writeFileSync path.join(r.dir, 'b.txt'), 'b\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'aa\n'
        fs.writeFileSync path.join(r.dir, 'b.txt'), 'bb\n'

        io = sink()
        withCwd(r.dir, -> add.add(['a.txt'], io, io.opts))

        staged = r.git('diff', '--cached', '--name-only')

        assert.match staged, /a\.txt/
        assert.doesNotMatch staged, /b\.txt/, 'b.txt must remain unstaged'
    catch err
        throw err
    finally
        r.cleanup()

test 'add: clean tree stays silent' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'

        io = sink()
        withCwd(r.dir, -> add.add([], io, io.opts))

        assert.equal io.text(), ''
    catch err
        throw err
    finally
        r.cleanup()

test 'commit: words become the message, new files included' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'changed\n'
        fs.writeFileSync path.join(r.dir, 'brand.txt'), 'new\n'

        io = sink()
        code = withCwd(r.dir, -> commit.commit(['fix' 'the' 'prompt'], io, io.opts))
        assert.equal code, 0
        assert.equal r.git('log', '-1', '--pretty=%s').trim(), 'fix the prompt'

        files = r.git 'show', '--name-only', '--pretty=format:', 'HEAD'

        assert.match files, /brand\.txt/, 'commit must include the new file, unlike git add -u'
    catch err
        throw err
    finally
        r.cleanup()

test 'commit: no words uses the hardcoded "misc" message' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'changed\n'

        io = sink()
        withCwd(r.dir, -> commit.commit([], io, io.opts))

        assert.equal r.git('log', '-1', '--pretty=%s').trim(), 'misc'
    catch err
        throw err
    finally
        r.cleanup()

test 'status: unaffected by the committed view — still says staged, uppercase' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'changed\n'
        r.git 'add', 'a.txt'

        io = sink()
        withCwd(r.dir, -> status.status([], io, io.opts))

        out = io.text()

        assert.match out, style.headingOf('staged'), 'kit status keeps the staged heading'
        assert.doesNotMatch out, /committed/, 'the commit view must not leak into kit status'
        assert.match out, /M\x20a\.txt/, 'letters stay uppercase'
    catch err
        throw err
    finally
        r.cleanup()

test 'add: unaffected by the committed view — still says staged, uppercase' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'changed\n'

        io = sink()
        withCwd(r.dir, -> add.add([], io, io.opts))

        out = io.text()

        assert.match out, style.headingOf('staged'), 'kit add keeps the staged heading'
        assert.doesNotMatch out, /committed/, 'the commit view must not leak into kit add'
        assert.match out, /M\x20a\.txt/, 'letters stay uppercase'
    catch err
        throw err
    finally
        r.cleanup()

test 'commit: shows the state it is about to commit, labelled committed' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'changed\n'
        fs.writeFileSync path.join(r.dir, 'brand.txt'), 'new\n'

        io = sink()
        withCwd(r.dir, -> commit.commit(['msg'], io, io.opts))

        out = io.text()

        assert.match out, /committed/, 'the pre-commit status render is intentional'
        assert.doesNotMatch out, style.headingOf('staged'), 'the staged heading is relabelled in the commit view'
        assert.match out, /a\x20brand\.txt/, 'a new file reads as lowercase a'
        assert.match out, /m\x20a\.txt/, 'a modification reads as lowercase m'
    catch err
        throw err
    finally
        r.cleanup()

test 'commit: from a subdirectory, unstaged keeps uppercase letters' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        fs.mkdirSync path.join(r.dir, 'sub'), {recursive: true}
        fs.writeFileSync path.join(r.dir, 'sub', 'keep.txt'), 'k\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'

        #  unreachable from sub/
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'top-level change\n'

        #  reachable
        fs.writeFileSync path.join(r.dir, 'sub', 'keep.txt'), 'changed\n'

        io = sink()
        withCwd(path.join(r.dir, 'sub'), -> commit.commit(['msg'], io, io.opts))

        out = io.text()

        assert.match out, style.headingOf('committed'), 'the reachable change is committed'
        assert.match out, /m\x20keep\.txt/, 'lowercase under committed'
        assert.match out, style.headingOf('unstaged'), 'the unreachable change is not staged'
        assert.match out, /M\x20\.\.\/a\.txt/, 'uppercase under unstaged: still git status there'
    catch err
        throw err
    finally
        r.cleanup()

test 'commit: nothing to commit exits 1 and stays silent on a clean tree' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'

        io = sink()
        code = withCwd(r.dir, -> commit.commit(['msg'], io, io.opts))
        assert.equal code, 1
        assert.equal io.text(), '', 'a clean tree produces no output at all'
    catch err
        throw err
    finally
        r.cleanup()

test 'commit: fully clean tree is silent' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'

        io = sink()
        code = withCwd(r.dir, -> commit.commit(['msg'], io, io.opts))
        assert.equal code, 1
        assert.equal io.text(), ''
    catch err
        throw err
    finally
        r.cleanup()

test 'commit: no-op from a subdirectory is silent, not git prose' ->

    #  Regression: `git add .` from a subdirectory cannot reach outside it, so
    #  commit has nothing staged and git blames "untracked files present" — even
    #  though the status tree printed a moment earlier already listed them.

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'init'
        fs.mkdirSync path.join(r.dir, 'sub'), {recursive: true}
        fs.writeFileSync path.join(r.dir, 'sub', 'keep.txt'), 'k\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'add sub'
        fs.writeFileSync path.join(r.dir, 'scratch.tmp'), 'x\n'

        io = sink()
        code = withCwd(path.join(r.dir, 'sub'), -> commit.commit(['noop'], io, io.opts))
        assert.equal code, 1, 'git still reports nothing to commit'
        assert.doesNotMatch io.text(), /nothing\x20added\x20to\x20commit/
        assert.doesNotMatch io.text(), /untracked\x20files\x20present/
    catch err
        throw err
    finally
        r.cleanup()

test 'all commands: not a git repository exits 128' ->

    dir = fs.mkdtempSync path.join(os.tmpdir(), 'kit-norepo-')
    try
        #  Named before the list, because an arrow function inside an array
        #  literal does not lex.

        runStatus = (io) -> status.status([], io, io.opts)
        runAdd = (io) -> add.add([], io, io.opts)
        runCommit = (io) -> commit.commit(['x'], io, io.opts)
        runLog = (io) -> log.log([], io, io.opts)

        cases = [
            ['status', runStatus]
            ['add', runAdd]
            ['commit', runCommit]
            ['log', runLog]
        ]

        for [name, invoke] in cases
            io = sink()
            code = withCwd(dir, -> invoke(io))
            assert.equal code, 128, "#{name} should exit 128 outside a repository"
            assert.match io.err.join('\n'), /not\x20a\x20git\x20repository/, "#{name} should say why"
    catch err
        throw err
    finally
        fs.rmSync(dir, {recursive: true, force: true})

dirtyRepo = (where) ->

    r = newRepo where
    fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
    r.git 'add', '-A'
    r.git 'commit', '-qm', 'init'
    fs.writeFileSync path.join(r.dir, 'a.txt'), 'changed\n'
    r

twoSiblings = ->

    parent = fs.mkdtempSync path.join(os.tmpdir(), 'kit-paths-')
    parent: parent
    a: dirtyRepo(path.join(parent, 'a'))
    b: dirtyRepo(path.join(parent, 'b'))

test 'status: the header names the repository root, not the directory run in' ->

    r = dirtyRepo()
    try
        fs.mkdirSync path.join(r.dir, 'sub')
        io = sink()
        code = withCwd(path.join(r.dir, 'sub'), -> status.status([], io, io.opts))
        assert.equal code, 0
        assert.match io.text(), style.headerOf(r.dir, r.branch)
        assert.match io.text(), /M\x20\.\.\/a\.txt/
    catch err
        throw err
    finally
        r.cleanup()

test 'status: a path argument reports that repository' ->

    r = dirtyRepo()
    try
        io = sink()
        assert.equal status.status([r.dir], io, io.opts), 0
        assert.match io.text(), style.headerOf(r.dir, r.branch)
        assert.match io.text(), /M\x20a\.txt/
    catch err
        throw err
    finally
        r.cleanup()

test 'status: two paths give two reports, in the order given' ->

    s = twoSiblings()
    try
        forward = sink()
        assert.equal status.status([s.a.dir, s.b.dir], forward, forward.opts), 0
        assert.match forward.text(), style.headerOf(s.a.dir, s.a.branch)
        assert.match forward.text(), style.headerOf(s.b.dir, s.b.branch)
        assert.ok forward.text().indexOf(s.a.dir) < forward.text().indexOf(s.b.dir),
            'reports follow the order of the arguments'

        reverse = sink()
        assert.equal status.status([s.b.dir, s.a.dir], reverse, reverse.opts), 0
        assert.ok reverse.text().indexOf(s.b.dir) < reverse.text().indexOf(s.a.dir),
            'and reversing the arguments reverses the output'
    catch err
        throw err
    finally
        fs.rmSync(s.parent, {recursive: true, force: true})

test 'status: a path argument replaces the current directory, it is not added to it' ->

    s = twoSiblings()
    try
        io = sink()
        code = withCwd(s.a.dir, -> status.status([s.b.dir], io, io.opts))
        assert.equal code, 0
        assert.match io.text(), style.headerOf(s.b.dir, s.b.branch)
        assert.ok not io.text().includes(s.a.dir), 'the shell directory is not reported'
    catch err
        throw err
    finally
        fs.rmSync(s.parent, {recursive: true, force: true})

test 'status: relative paths resolve against the directory kit started in' ->

    s = twoSiblings()
    try
        io = sink()
        code = withCwd(s.a.dir, -> status.status(['.', '../b'], io, io.opts))
        assert.equal code, 0
        assert.match io.text(), style.headerOf(s.a.dir, s.a.branch), '. is this directory'
        assert.match io.text(), style.headerOf(s.b.dir, s.b.branch), '../b is the sibling of a'
    catch err
        throw err
    finally
        fs.rmSync(s.parent, {recursive: true, force: true})

test 'status: a relative path from a subdirectory climbs back out' ->

    s = twoSiblings()
    try
        fs.mkdirSync path.join(s.a.dir, 'sub')
        io = sink()
        code = withCwd(path.join(s.a.dir, 'sub'), -> status.status(['../../b'], io, io.opts))
        assert.equal code, 0
        assert.match io.text(), style.headerOf(s.b.dir, s.b.branch)
    catch err
        throw err
    finally
        fs.rmSync(s.parent, {recursive: true, force: true})

test 'status: a clean repository in the list contributes nothing' ->

    parent = fs.mkdtempSync path.join(os.tmpdir(), 'kit-paths-')
    try
        dirty = dirtyRepo path.join(parent, 'dirty')
        clean = newRepo path.join(parent, 'clean')
        fs.writeFileSync path.join(clean.dir, 'a.txt'), 'a\n'
        clean.git 'add', '-A'
        clean.git 'commit', '-qm', 'init'

        io = sink()
        assert.equal status.status([clean.dir, dirty.dir], io, io.opts), 0
        assert.match io.text(), style.headerOf(dirty.dir, dirty.branch)
        assert.ok not io.text().includes(clean.dir), 'the clean repository is not mentioned'
    catch err
        throw err
    finally
        fs.rmSync(parent, {recursive: true, force: true})

test 'status: a path that is not a repository is named, and the rest still report' ->

    r = dirtyRepo()
    stranger = fs.mkdtempSync path.join(os.tmpdir(), 'kit-stranger-')
    try
        io = sink()
        code = status.status([r.dir, stranger], io, io.opts)
        assert.equal code, 128, 'git exits 128 for "not a repository"'
        assert.ok io.err.join('\n').includes(stranger), 'and says which path it was'
        assert.match io.err.join('\n'), /not\x20a\x20git\x20repository/
        assert.match io.text(), style.headerOf(r.dir, r.branch), 'one bad path does not lose the others'
    catch err
        throw err
    finally
        fs.rmSync(stranger, {recursive: true, force: true})
        r.cleanup()

test 'status: a path that does not exist is reported as such, not as a bad repo' ->

    missing = path.join os.tmpdir(), 'kit-absent-42'
    io = sink()
    code = status.status [missing], io, io.opts

    assert.equal code, 128
    assert.ok io.err.join('\n').includes(missing)
    assert.match io.err.join('\n'), /no\x20such\x20directory/
    assert.doesNotMatch io.err.join('\n'), /not\x20a\x20git\x20repository/
    assert.equal io.text(), '', 'and nothing is reported for it'

test 'status: a bare repository and a .git directory are not work trees' ->

    parent = fs.mkdtempSync path.join(os.tmpdir(), 'kit-bare-')
    try
        bare = path.join parent, 'bare.git'
        fs.mkdirSync bare
        cp.execFileSync 'git', ['init' '-q' '--bare' '.'], {cwd: bare, stdio: 'pipe'}
        repo = newRepo path.join(parent, 'repo')

        for p in [bare, path.join(repo.dir, '.git')]
            io = sink()
            assert.equal status.status([p], io, io.opts), 128, "#{p} is not a work tree"
            assert.match io.err.join('\n'), /no\x20work\x20tree/
            assert.equal io.text(), ''
    catch err
        throw err
    finally
        fs.rmSync(parent, {recursive: true, force: true})

#  A plain directory that holds repositories rather than being one, the shape
#  ~/s has: nothing to report at the top, everything to report one level down.

nest = ->

    parent = fs.mkdtempSync path.join(os.tmpdir(), 'kit-nest-')
    parent: parent
    a: dirtyRepo(path.join(parent, 'a'))
    b: dirtyRepo(path.join(parent, 'b'))

test 'status: a directory that is not a repository reports the ones one level down' ->

    n = nest()
    try
        io = sink()
        assert.equal status.status([n.parent], io, io.opts), 0
        assert.match io.text(), style.headerOf(n.a.dir, n.a.branch)
        assert.match io.text(), style.headerOf(n.b.dir, n.b.branch)
        assert.ok io.text().indexOf(n.a.dir) < io.text().indexOf(n.b.dir),
            'the repositories below are reported in name order'
        assert.equal io.err.length, 0, 'and the directory itself is not a problem'
    catch err
        throw err
    finally
        fs.rmSync(n.parent, {recursive: true, force: true})

test 'status: the shell directory is looked one level down too' ->

    n = nest()
    try
        io = sink()
        assert.equal withCwd(n.parent, -> status.status([], io, io.opts)), 0
        assert.match io.text(), style.headerOf(n.a.dir, n.a.branch)
        assert.match io.text(), style.headerOf(n.b.dir, n.b.branch)
    catch err
        throw err
    finally
        fs.rmSync(n.parent, {recursive: true, force: true})

test 'status: a clean repository one level down contributes nothing' ->

    n = nest()
    try
        clean = newRepo path.join(n.parent, 'clean')
        fs.writeFileSync path.join(clean.dir, 'a.txt'), 'a\n'
        clean.git 'add', '-A'
        clean.git 'commit', '-qm', 'init'

        io = sink()
        assert.equal status.status([n.parent], io, io.opts), 0, 'silence is not an error'
        assert.match io.text(), style.headerOf(n.a.dir, n.a.branch)
        assert.ok not io.text().includes(clean.dir), 'the clean repository is not mentioned'
    catch err
        throw err
    finally
        fs.rmSync(n.parent, {recursive: true, force: true})

test 'status: a directory with no repository below it is still not a repository' ->

    parent = fs.mkdtempSync path.join(os.tmpdir(), 'kit-empty-')
    try
        io = sink()
        assert.equal status.status([parent], io, io.opts), 128
        assert.match io.err.join('\n'), /not\x20a\x20git\x20repository/
        assert.ok io.err.join('\n').includes(parent), 'and it is named'
        assert.equal io.text(), '', 'and nothing is reported'
    catch err
        throw err
    finally
        fs.rmSync(parent, {recursive: true, force: true})

test 'status: a plain file below a directory is not a repository to report' ->

    n = nest()
    try
        fs.writeFileSync path.join(n.parent, 'a', 'notes.txt'), 'x\n'
        io = sink()
        assert.equal status.status([path.join(n.parent, 'a', 'notes.txt')], io, io.opts), 128
        assert.match io.err.join('\n'), /not\x20a\x20git\x20repository/
    catch err
        throw err
    finally
        fs.rmSync(n.parent, {recursive: true, force: true})

test 'status: dot directories and plain directories one level down are skipped' ->

    n = nest()
    try
        fs.mkdirSync path.join(n.parent, '.cache')

        #  a repository, but under a dot directory
        dirtyRepo path.join(n.parent, '.cache', 'hidden')

        #  a directory that is not a repository
        fs.mkdirSync path.join(n.parent, 'notes')

        io = sink()
        assert.equal status.status([n.parent], io, io.opts), 0
        assert.match io.text(), style.headerOf(n.a.dir, n.a.branch)
        assert.ok not io.text().includes('hidden'), 'nothing under a dot directory is reported'
        assert.ok not io.text().includes('notes'), 'a directory that is not a repository is not reported'
    catch err
        throw err
    finally
        fs.rmSync(n.parent, {recursive: true, force: true})

test 'status: a repository reached through a symlink one level down is reported' ->

    n = nest()
    try
        fs.symlinkSync n.a.dir, path.join(n.parent, 'linked'), 'dir'
        io = sink()
        assert.equal status.status([n.parent], io, io.opts), 0
        assert.match io.text(), style.headerOf(n.a.dir, n.a.branch)
    catch err
        throw err
    finally
        fs.rmSync(n.parent, {recursive: true, force: true})

test 'status: a repository that contains another repository reports only itself' ->

    outer = dirtyRepo()
    try
        inner = dirtyRepo path.join(outer.dir, 'inner')
        io = sink()
        assert.equal status.status([outer.dir], io, io.opts), 0
        assert.match io.text(), style.headerOf(outer.dir, outer.branch)
        assert.doesNotMatch io.text(), style.headerOf(inner.dir, inner.branch)
    catch err
        throw err
    finally
        outer.cleanup()

test 'status: one bad path among repositories that are looked into still exits 128' ->

    n = nest()
    stranger = fs.mkdtempSync path.join(os.tmpdir(), 'kit-stranger-')
    try
        io = sink()
        assert.equal status.status([n.parent, stranger], io, io.opts), 128
        assert.match io.text(), style.headerOf(n.a.dir, n.a.branch)
        assert.match io.err.join('\n'), /not\x20a\x20git\x20repository/
    catch err
        throw err
    finally
        fs.rmSync(stranger, {recursive: true, force: true})
        fs.rmSync(n.parent, {recursive: true, force: true})

test 'add and commit: the header names the repository root too' ->

    r = dirtyRepo()
    try
        added = sink()
        withCwd(r.dir, -> add.add([], added, added.opts))
        assert.match added.text(), style.headerOf(r.dir, r.branch)

        fs.writeFileSync path.join(r.dir, 'b.txt'), 'b\n'

        committed = sink()
        withCwd(r.dir, -> commit.commit(['msg'], committed, committed.opts))
        assert.match committed.text(), style.headerOf(r.dir, r.branch)
        assert.match committed.text(), style.headingOf 'committed'
    catch err
        throw err
    finally
        r.cleanup()

repoWithCommits = (n) ->

    r = newRepo()

    for i in 1...n + 1
        fs.writeFileSync path.join(r.dir, "f#{i}.txt"), "#{i}\n"
        r.git 'add', '-A'
        r.git 'commit', '-qm', "commit #{i}"

    r

test 'log: empty history is silent and exits 0' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        io = sink()
        code = withCwd(r.dir, -> log.log([], io, io.opts))
        assert.equal code, 0
        assert.equal io.text(), '', 'a repo with no commits prints nothing'
    catch err
        throw err
    finally
        r.cleanup()

test 'log: lists every commit, oldest first' ->

    r = repoWithCommits 3
    try
        io = sink()
        withCwd(r.dir, -> log.log([], io, io.opts))
        lines = io.text().split '\n'
        assert.equal lines.length, 3
        assert.match lines[0], /commit\x201$/, 'oldest first'
        assert.match lines[2], /commit\x203$/, 'newest last'
    catch err
        throw err
    finally
        r.cleanup()

test 'log: a bare number limits to that many commits' ->

    r = repoWithCommits 5
    try
        io = sink()
        withCwd(r.dir, -> log.log(['2'], io, io.opts))
        lines = io.text().split '\n'
        assert.equal lines.length, 2, 'a commit count, not a line count'

        #  The count still selects the two *most recent* commits — reversing the
        #  display must not turn `kit log 2` into the two oldest. git applies -n
        #  before --reverse, so the limit is unaffected by the ordering.

        assert.match lines[0], /commit\x204$/, 'the older of the two most recent'
        assert.match lines[1], /commit\x205$/, 'the newest is last'

        older = lines.filter (l) -> (/commit\x20[123]$/).test l
        assert.equal older.length, 0, 'nothing older is shown'
    catch err
        throw err
    finally
        r.cleanup()

test 'log: zero is silent' ->

    r = repoWithCommits 3
    try
        io = sink()
        code = withCwd(r.dir, -> log.log(['0'], io, io.opts))
        assert.equal code, 0
        assert.equal io.text(), ''
    catch err
        throw err
    finally
        r.cleanup()

test 'log: shows a short hash and never a full 40-character one' ->

    r = repoWithCommits 1
    try
        io = sink()
        withCwd(r.dir, -> log.log([], io, io.opts))
        line = io.text()
        full = r.git('rev-parse', 'HEAD').trim()
        assert.ok line.includes(full.slice(0, 7)), 'the short hash is present'
        assert.ok not line.includes(full), 'the full hash is not'
    catch err
        throw err
    finally
        r.cleanup()

test 'log: shows the author name without the email address' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'

        env = Object.assign {}, r.env, {
            GIT_AUTHOR_NAME: 'Thorsten'
            GIT_COMMITTER_NAME: 'Thorsten'
            GIT_AUTHOR_EMAIL: 't@e.st'
        }

        cp.execFileSync 'git', ['commit' '-qm' 'authored'], {cwd: r.dir, encoding: 'utf8', env}

        io = sink()
        withCwd(r.dir, -> log.log([], io, io.opts))
        line = io.text()

        assert.match line, /Thorsten/, 'the author name appears'
        assert.ok not line.includes('t@e.st'), 'the email address does not'
    catch err
        throw err
    finally
        r.cleanup()

test 'log: date is the short absolute form without seconds' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'

        env = Object.assign {}, r.env, {GIT_AUTHOR_DATE: '2020-01-02T03:04:05 +0000'}

        cp.execFileSync 'git', ['commit' '-qm' 'dated'], {cwd: r.dir, encoding: 'utf8', env}

        io = sink()
        withCwd(r.dir, -> log.log([], io, io.opts))

        local = new Date '2020-01-02T03:04:05Z'
        hours = String(local.getHours()).padStart 2, '0'
        want = "Jan  #{local.getDate()} #{hours}:04"

        assert.ok io.text().includes(want), "date should read \"#{want}\", got: #{io.text()}"
        assert.ok not (/03:04:\d\d/).test(io.text()), 'seconds are not shown'
        assert.ok not (/2020/).test(io.text()), 'the year is not shown'
    catch err
        throw err
    finally
        r.cleanup()

#  A run of commits written on chosen days, at chosen times so the order is not a
#  coincidence of the clock. git renders the date in the local zone, so the tests
#  below read the expectation back out of a Date rather than assuming one.

datedRepo = ->

    r = newRepo()

    dated = (msg, iso) ->
        fs.writeFileSync path.join(r.dir, "#{msg}.txt"), "#{msg}\n"
        r.git 'add', '-A'
        env = Object.assign {}, r.env, {GIT_AUTHOR_DATE: iso, GIT_COMMITTER_DATE: iso}
        cp.execFileSync 'git', ['commit' '-qm' msg], {cwd: r.dir, encoding: 'utf8', env}

    dated 'first', '2020-05-04T09:15:00 +0000'
    dated 'second', '2020-05-04T11:45:00 +0000'
    dated 'third', '2020-06-07T08:30:00 +0000'

    r

#  The date column, between the short hash and the author: the hash is seven
#  characters and one space wide.

dateOf = (line) -> line.slice 8, 20

#  The date as git prints it here: "%b %e %H:%M", in the local zone. The month
#  is spelled out rather than derived, because %b is the locale's business.

localDate = (month, iso, minutes) ->

    d = new Date iso
    day = String(d.getDate()).padStart 2, ' '
    "#{month} #{day} #{String(d.getHours()).padStart(2, '0')}:#{minutes}"

#  A date whose calendar part has been blanked, which is to say: the time kept,
#  the rest spaces. Slicing the time off the date it belongs to is what keeps
#  this independent of the zone the machine happens to be in.

blanked = (date) -> ' '.repeat(date.length - 5) + date.slice(-5)

#  The three commits datedRepo() writes, as this machine's zone spells them.

FIRST = localDate 'May', '2020-05-04T09:15:00Z', '15'
SECOND = localDate 'May', '2020-05-04T11:45:00Z', '45'
THIRD = localDate 'Jun', '2020-06-07T08:30:00Z', '30'

test 'log: a date the line above already gave is blanked to spaces' ->

    r = datedRepo()
    try
        io = sink()
        withCwd(r.dir, -> log.log([], io, Object.assign({}, io.opts, {width: 200})))
        dates = io.text().split('\n').map dateOf

        assert.equal dates[0], FIRST, 'the first line carries the date in full'
        assert.equal dates[1], blanked(SECOND), 'the second is the same day, so only its time is left'
        assert.equal dates[2], THIRD, 'a new month is written out in full'
    catch err
        throw err
    finally
        r.cleanup()

test 'log: -l writes the date on every line, blanked or not' ->

    r = datedRepo()
    try
        io = sink()
        withCwd(r.dir, -> log.log(['-l'], io, Object.assign({}, io.opts, {width: 200})))
        assert.deepEqual io.text().split('\n').map(dateOf), [FIRST, SECOND, THIRD]
    catch err
        throw err
    finally
        r.cleanup()

test 'log: a non-numeric argument errors instead of printing everything' ->

    r = repoWithCommits 3
    try
        io = sink()
        code = withCwd(r.dir, -> log.log(['foo'], io, io.opts))
        assert.equal code, 1
        assert.equal io.text(), '', 'no history is printed'
        assert.match io.err.join('\n'), /not\x20a\x20commit\x20count/
    catch err
        throw err
    finally
        r.cleanup()

test 'log: -l shows the commit body, which short mode hides' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        fs.writeFileSync path.join(r.dir, 'msg.txt'), 'the subject line\n\nA body paragraph that only --long shows.\n\nAnd a second one.'
        r.git 'commit', '-q', '-F', 'msg.txt'

        short = sink()
        withCwd(r.dir, -> log.log([], short, Object.assign({}, short.opts, {width: 200})))
        assert.match short.text(), /the\x20subject\x20line/
        assert.ok not short.text().includes('A body paragraph'), 'short mode hides the body'

        long = sink()
        withCwd(r.dir, -> log.log(['-l'], long, Object.assign({}, long.opts, {width: 200})))
        assert.match long.text(), /A\x20body\x20paragraph/, '-l shows the body'
        assert.match long.text(), /And\x20a\x20second\x20one\./
    catch err
        throw err
    finally
        r.cleanup()

test 'log: -l and --long are equivalent' ->

    r = repoWithCommits 2
    try
        a = sink()
        b = sink()
        withCwd(r.dir, -> log.log(['-l', '2'], a, Object.assign({}, a.opts, {width: 100})))
        withCwd(r.dir, -> log.log(['--long', '2'], b, Object.assign({}, b.opts, {width: 100})))
        assert.equal a.text(), b.text()
    catch err
        throw err
    finally
        r.cleanup()

test 'log: -l with a count returns exactly that many commits' ->

    r = repoWithCommits 5
    try
        io = sink()
        withCwd(r.dir, -> log.log(['-l', '2'], io, Object.assign({}, io.opts, {width: 100})))
        hashes = io.text().match(/^[0-9a-f]{7}\x20/gm) ? []
        assert.equal hashes.length, 2, 'a commit count, not a line count'
    catch err
        throw err
    finally
        r.cleanup()

test 'log: -l 0 is silent' ->

    r = repoWithCommits 3
    try
        io = sink()
        code = withCwd(r.dir, -> log.log(['-l', '0'], io, Object.assign({}, io.opts, {width: 100})))
        assert.equal code, 0
        assert.equal io.text(), ''
    catch err
        throw err
    finally
        r.cleanup()

test 'log: output respects the terminal width it is given' ->

    r = repoWithCommits 1
    try
        io = sink()
        withCwd(r.dir, -> log.log([], io, Object.assign({}, io.opts, {width: 80})))
        line = io.text().replace(/\u001b\[[0-9;]*m/g, '')
        len = Array.from(line).length
        assert.ok len <= 80, "line of #{len} must fit 80"
    catch err
        throw err
    finally
        r.cleanup()

test 'log: a subject with spaces and colons is preserved' ->

    r = newRepo()
    try
        fs.writeFileSync path.join(r.dir, 'a.txt'), 'a\n'
        r.git 'add', '-A'
        r.git 'commit', '-qm', 'fix: handle empty tree and  spaces'

        io = sink()
        withCwd(r.dir, -> log.log([], io, io.opts))
        assert.match io.text(), /fix:\x20handle\x20empty\x20tree\x20and\x20{2}spaces$/
    catch err
        throw err
    finally
        r.cleanup()