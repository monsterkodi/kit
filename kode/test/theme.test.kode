###
█████████  ███   ███  ████████  ██     ██  ████████
   ███     ███   ███  ███       ███   ███  ███
   ███     █████████  ███████   █████████  ███████
   ███     ███   ███  ███       ███ █ ███  ███
   ███     ███   ███  ████████  ███   ███  ████████
###

import test from 'node:test'
import assert from 'node:assert/strict'

use ../git
use ../render
use ../theme
use ./style

SGR = /\u001b\[[0-9;]*m/g

strip = (s) -> s.replace SGR, ''

setNoColor = (value) ->

    if value == undefined then delete process.env.NO_COLOR
    else process.env.NO_COLOR = value

withNoColor = (value, fn) ->

    before = process.env.NO_COLOR
    setNoColor value

    try
        r = fn()
    catch err
        setNoColor before
        throw err

    setNoColor before
    r

names = [
    'add' 'del' 'mod' 'untracked' 'branch' 'repoPath' 'dim' 'bold'
    'headStaged' 'headCommitted' 'headUnstaged' 'headUntracked' 'ahead' 'behind'
    'logHash' 'logDate' 'logName'
    ]

test 'createTheme: a plain palette emits no escape sequences' ->

    t = theme.createTheme false
    assert.equal t.enabled, false

    for name in names
        assert.doesNotMatch t[name]('x'), SGR, "#{name} must not colour when disabled"

test 'createTheme: an enabled palette colours, and passes text through' ->

    t = theme.createTheme true
    assert.equal t.enabled, true

    hasColour = (s) -> (new RegExp(SGR)).test s

    assert.ok hasColour(t.add('x')), 'add colours'
    assert.ok hasColour(t.dim('x')), 'dim colours'
    assert.ok hasColour(t.branch('main')), 'branch colours'
    assert.equal strip(t.dim('keep this')), 'keep this', 'the text survives the escape codes'

test 'createTheme: both palettes render the same text once stripped' ->

    on  = theme.createTheme true
    off = theme.createTheme false

    for name in ['add' 'del' 'branch' 'repoPath' 'dim' 'logHash']
        assert.equal strip(on[name]('x')), strip(off[name]('x')), name

test 'theme: the default palette follows NO_COLOR as loaded' ->

    colour = withNoColor('1', -> theme.createTheme(false))
    assert.equal colour.enabled, false

    plain = withNoColor(undefined, -> theme.createTheme(true))
    assert.equal plain.enabled, true

    assert.equal typeof(theme.theme.enabled), 'boolean', 'the default export carries its own flag'

###
████████   ████████  ███   ███  ███████    ████████  ████████   ████████  ████████    ███████
███   ███  ███       ████  ███  ███   ███  ███       ███   ███  ███       ███   ███  ███     
███████    ███████   ███ █ ███  ███   ███  ███████   ███████    ███████   ███████    ███████ 
███   ███  ███       ███  ████  ███   ███  ███       ███   ███  ███       ███   ███       ███
███   ███  ████████  ███   ███  ███████    ████████  ███   ███  ████████  ███   ███  ███████ 
###

tree = ->
    raw = [
        '# branch.oid abc123def456'
        '# branch.head main'
        '1 A. N... 100644 100644 100644 a b src/new.mjs'
        '? build/'
        ].join('\0') + '\0'
    git.parseStatusV2 raw

commit = hash: 'c63ebbf', date: 'Oct  2 00:18', name: 'Thorsten', subject: 'third'

cases =
    status: -> render.renderStatus(tree(), {theme: style.plainTheme})
    log: -> render.renderLog([commit], {theme: style.plainTheme})
    entry: -> render.renderEntry({path: 'a.mjs', code: 'M'}, {theme: style.plainTheme})
    commit: -> render.renderCommitSuccess('[master e3cd348] fourth', {theme: style.plainTheme})

all = -> Object.fromEntries(Object.entries(cases).map(([k, fn]) -> [k, fn()]))

test 'renderers: output does not depend on NO_COLOR once a palette is passed' ->

    unset = withNoColor(undefined, -> all())
    set = withNoColor('1', -> all())

    for key in Object.keys cases
        assert.equal set[key], unset[key], "#{key} must not read NO_COLOR"
        assert.doesNotMatch unset[key], SGR, "#{key} must be plain when handed a plain palette"

test 'renderers: the palette argument wins over the environment' ->

    enabled = theme.createTheme true

    forcedPlain = withNoColor('1', -> render.renderLog([commit], {theme: theme.createTheme(false)}))
    assert.doesNotMatch forcedPlain, SGR, 'an explicit plain palette beats NO_COLOR'

    forcedColour = withNoColor(undefined, -> render.renderLog([commit], {theme: enabled}))
    assert.match forcedColour, SGR, 'an explicit enabled palette survives an unset NO_COLOR'

test 'renderers: an omitted palette falls back to the default, not a crash' ->

    out = render.renderLog [commit], {width: 200}

    assert.ok out.includes('third'), 'the subject renders with no palette argument at all'
