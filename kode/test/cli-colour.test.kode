import test from 'node:test'
import assert from 'node:assert/strict'

use url child_process
use ../status
use ../log
use ../theme

KIT = url.fileURLToPath(new URL('../../bin/kit', import.meta.url))

SGR = /\u001b\[[0-9;]*m/

kit = (args, env={}) ->

    r = child_process.spawnSync process.execPath, [KIT].concat(args), {
        encoding: 'utf8'
        env: Object.assign({}, process.env, {NO_COLOR: undefined, TERM: 'xterm'}, env)
    }

    code: r.status
    out: r.stdout
    err: r.stderr

test 'kit log: colour follows the stream, not the environment' ->

    piped = kit ['log', '1']

    assert.ok piped.out, 'the entry point ran'
    assert.doesNotMatch piped.out, SGR, 'piped output is plain with NO_COLOR unset'

    forced = kit(['log', '1'], {FORCE_COLOUR: '1'})

    assert.equal forced.out, piped.out, 'output does not vary'

test 'kit log: NO_COLOR still wins when a terminal is faked' ->

    plain = kit ['log', '1']
    noColour = kit(['log', '1'], {NO_COLOR: '1'})

    assert.equal plain.code, noColour.code
    assert.doesNotMatch noColour.out, SGR

test 'every subcommand still runs with the palette threaded through' ->

    quiet =
        log: ->
        error: ->

    palette = theme.createTheme true

    st = status.status [], quiet, {theme: palette}
    assert.ok [0, 128].includes(st), "status returned #{st}"

    lg = log.log ['log', '1'], quiet, {theme: palette}
    assert.ok [0, 1, 128].includes(lg), "log returned #{lg}"