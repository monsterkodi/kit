use url child_process
use ../status
use ../log
use ../theme
use ./helpers ▪ matches notMatches

KIT = url.fileURLToPath(new URL('../../bin/kit', import.meta.url))

SGR = /\u001b\[[0-9;]*m/

kit = (args, env={}) ->

    r = child_process.spawnSync process.execPath, [KIT].concat(args), {
        encoding: 'utf8'
        env: Object.assign({}, process.env, {NO_COLOR: undefined, TERM: 'xterm'}, env)
    }

    code: r.status
    out: r.stdout
    err: r.stderr

▸ kit log

    ▸ colour follows the stream, not the environment

        piped = kit ['log', '1']

        piped.out.length > 0 ▸ yes
        notMatches piped.out, SGR

        forced = kit(['log', '1'], {FORCE_COLOUR: '1'})

        forced.out ▸ piped.out

    ▸ NO_COLOR still wins when a terminal is faked

        plain = kit ['log', '1']
        noColour = kit(['log', '1'], {NO_COLOR: '1'})

        plain.code ▸ noColour.code
        notMatches noColour.out, SGR

▸ every subcommand

    ▸ still runs with the palette threaded through

        quiet =
            log: ->
            error: ->

        palette = theme.createTheme true

        st = status.status [], quiet, {theme: palette}
        [0 128].includes(st) ▸ yes

        lg = log.log ['log', '1'], quiet, {theme: palette}
        [0 1 128].includes(lg) ▸ yes
