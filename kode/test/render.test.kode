###
████████   ████████  ███   ███  ███████    ████████  ████████
███   ███  ███       ████  ███  ███   ███  ███       ███   ███
████████   ███████   ███ █ ███  ███   ███  ███████   ███████
███   ███  ███       ███  ████  ███   ███  ███       ███   ███
███   ███  ████████  ███   ███  ███████    ████████  ███   ███
###

#  unit tests for the pure renderers.
#
#  No git, no repository, no child processes: these assert layout and colour
#  decisions directly. Run with NO_COLOR=1 so assertions stay readable.
#
#  A regex literal may not contain a space — the lexer reads it as a separator —
#  so every space below is \x20. It is the same character and it survives.

import test from 'node:test'
import assert from 'node:assert/strict'

use ../git
use ../render
use ./style

NUL = '\0'

test 'parseStatusV2: headers, staged/unstaged split' ->

    raw = [
        '# branch.oid abc123def456'
        '# branch.head main'
        '# branch.upstream origin/main'
        '# branch.ab +2 -1'
        '1 M. N... 100644 100644 100644 aaa bbb src/a.mjs'
        '1 .M N... 100644 100644 100644 aaa ccc src/b.mjs'
        '? build/'
        ].join(NUL) + NUL

    d = git.parseStatusV2 raw

    assert.equal d.branch, 'main'
    assert.equal d.upstream, 'origin/main'
    assert.equal d.ahead, 2
    assert.equal d.behind, 1
    assert.deepEqual d.staged, [{path: 'src/a.mjs', code: 'M'}]
    assert.deepEqual d.unstaged, [{path: 'src/b.mjs', code: 'M'}]
    assert.deepEqual d.untracked, [{path: 'build/', code: '?'}]

test 'parseStatusV2: rename consumes the origin path record' ->

    raw = [
        '2 RM N... 100644 100644 100644 aaa bbb R100 renamed.txt'
        'a b.txt'
        ].join(NUL) + NUL

    d = git.parseStatusV2 raw

    assert.equal d.staged.length, 1
    assert.equal d.staged[0].path, 'renamed.txt'
    assert.equal d.staged[0].orig, 'a b.txt'

test 'parseStatusV2: filename with a space is one path' ->

    raw = ['1 A. N... 100644 100644 100644 a b my file.txt'].join(NUL) + NUL

    d = git.parseStatusV2 raw

    assert.equal d.staged[0].path, 'my file.txt'

###
 ███████  █████████  ███   ███  ███      ████████
███          ███      ███ ███   ███      ███     
███████      ███       █████    ███      ███████ 
     ███     ███        ███     ███      ███     
███████      ███        ███     ███████  ████████
###

#  Style-tolerant assertions live in ./style.kode: the branch header and the group
#  markers are the two parts of kit's output that get restyled, so the tests
#  below pin what they mean and leave how they look open.

test 'renderStatus: clean tree renders nothing' ->

    d = branch: 'main', staged: [], unstaged: [], untracked: []

    assert.equal render.renderStatus(d, {theme: style.plainTheme}), ''

test 'renderStatus: a clean tree in sync with its upstream renders nothing' ->

    d = branch: 'main', ahead: 0, behind: 0, staged: [], unstaged: [], untracked: []

    assert.equal render.renderStatus(d, {theme: style.plainTheme}), '', 'in sync is not worth a line'

test 'renderStatus: a clean tree ahead of its upstream renders the header alone' ->

    d =
        root: '/home/kodi/s/kit'
        branch: 'main'
        ahead: 2
        behind: 0
        staged: []
        unstaged: []
        untracked: []

    out = render.renderStatus d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme})

    assert.equal style.plain(out).split('\n').length, 1, 'the header, and nothing after it'
    assert.match out, style.headerOf('~/s/kit', 'main ↑2')
    assert.equal style.headingLines(out).length, 0, 'a clean tree has no sections to list'

test 'renderStatus: a clean tree behind its upstream renders the header alone' ->

    d =
        root: '/home/kodi/s/kit'
        branch: 'main'
        ahead: 0
        behind: 3
        staged: []
        unstaged: []
        untracked: []

    out = render.renderStatus d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme})

    assert.equal style.plain(out).split('\n').length, 1
    assert.match out, style.headerOf('~/s/kit', 'main ↓3')

test 'outOfSync: only a branch with commits on one side counts' ->

    assert.equal render.outOfSync({ahead: 0, behind: 0}), false
    assert.equal render.outOfSync({}), false, 'no upstream means nothing to be out of sync with'
    assert.equal render.outOfSync(), false
    assert.equal render.outOfSync({ahead: 1, behind: 0}), true
    assert.equal render.outOfSync({ahead: 0, behind: 1}), true

test 'renderStatus: dirty tree has branch header and all three sections' ->

    d =
        branch: 'main'
        ahead: 2
        behind: 0
        detached: false
        staged: [{path: 'src/new.mjs', code: 'A'}]
        unstaged: [{path: 'src/a.mjs', code: 'M'}]
        untracked: [{path: 'build/'}]

    out = render.renderStatus d, {theme: style.plainTheme}

    assert.match out, /main\x20↑2/
    assert.match out, style.headingOf('staged')
    assert.match out, style.headingOf('unstaged')
    assert.match out, style.headingOf('untracked')
    assert.match out, /A\x20src\/new\.mjs/
    assert.match out, /M\x20src\/a\.mjs/
    assert.match out, /\?\x20build\//

test 'renderStatus: empty sections are omitted and the last group closes the list' ->

    d = branch: 'main', staged: [], unstaged: [{path: 'a', code: 'M'}], untracked: []

    heads = style.headingLines render.renderStatus(d, {theme: style.plainTheme})

    assert.doesNotMatch heads.join('\n'), style.headingOf('staged'), 'an empty group is not rendered'
    assert.equal heads.length, 1, 'only the one non-empty group renders'
    assert.match heads[0], style.headingOf('unstaged'), 'the only group is also the last'

test 'renderBranch: detached head shows short oid' ->

    out = render.renderBranch {detached: true, oid: 'abcdef1234567890'}, {theme: style.plainTheme}

    assert.match out, /detached@abcdef1/

#  The branch header: which repository, then which branch.
#
#  Every assertion here goes through headerOf, so none of them can tell a leading
#  space from three, a pipe from a space, or one colour from another. What they
#  pin is the content and the order — and that is deliberate, because the header
#  is the part of kit's output most likely to be restyled.

test 'renderStatus: the header names the repository root, then the branch' ->

    d =
        root: '/home/kodi/s/kit'
        branch: 'main'
        staged: []
        unstaged: [{path: 'a', code: 'M'}]
        untracked: []

    out = render.renderStatus d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme})

    assert.match out, style.headerOf('~/s/kit', 'main')

test 'renderStatus: the root identifies the repository, not the directory kit ran in' ->

    d =
        root: '/home/kodi/a'
        branch: 'master'
        staged: []
        unstaged: [{path: '../top.txt', code: 'M'}]
        untracked: []

    out = render.renderStatus d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme})

    assert.match out, style.headerOf('~/a', 'master')

test 'renderStatus: ahead and behind stay legible after the root' ->

    d =
        root: '/home/kodi/s/kit'
        branch: 'main'
        ahead: 2
        behind: 1
        staged: []
        unstaged: [{path: 'a', code: 'M'}]
        untracked: []

    header = style.plain(render.renderStatus(d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme}))).split('\n')[0]

    assert.match header, style.headerOf('~/s/kit', 'main ↑2 ↓1')

test 'renderStatus: a detached head keeps its short oid beside the root' ->

    d =
        root: '/home/kodi/s/kit'
        detached: true
        oid: 'abcdef1234567890'
        staged: []
        unstaged: [{path: 'a', code: 'M'}]
        untracked: []

    out = render.renderStatus d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme})

    assert.match out, style.headerOf('~/s/kit', 'detached@abcdef1')

test 'renderStatus: a root outside home is shown in full' ->

    d =
        root: '/tmp/kit-test-1'
        branch: 'main'
        staged: []
        unstaged: [{path: 'a', code: 'M'}]
        untracked: []

    out = render.renderStatus d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme})

    assert.match out, style.headerOf('/tmp/kit-test-1', 'main')

test 'renderStatus: a root that merely starts with home is not shortened' ->

    #  /home/kodi-other must not become ~-other.

    d =
        root: '/home/kodi-other'
        branch: 'main'
        staged: []
        unstaged: [{path: 'a', code: 'M'}]
        untracked: []

    out = render.renderStatus d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme})

    assert.match out, style.headerOf('/home/kodi-other', 'main')

test 'renderStatus: without a root the header is the branch alone' ->

    d = branch: 'main', staged: [], unstaged: [{path: 'a', code: 'M'}], untracked: []

    out = render.renderStatus d, Object.assign({}, {home: '/home/kodi'}, {theme: style.plainTheme})

    assert.equal style.plain(out).split('\n')[0], 'main'

test 'abbreviateHome: a path under home loses the prefix' ->

    assert.equal render.abbreviateHome('/home/kodi/s/kit', '/home/kodi'), '~/s/kit'
    assert.equal render.abbreviateHome('/home/kodi', '/home/kodi'), '~'

test 'abbreviateHome: everything else is left exactly as it is' ->

    assert.equal render.abbreviateHome('/tmp/x', '/home/kodi'), '/tmp/x'
    assert.equal render.abbreviateHome('/home/kodi-other', '/home/kodi'), '/home/kodi-other'
    assert.equal render.abbreviateHome('~/s/kit', '/home/kodi'), '~/s/kit'
    assert.equal render.abbreviateHome('/home/kodi/s/kit', '/home/kodi/'), '~/s/kit', 'a trailing slash on home'

test 'abbreviateHome: with no home to compare against, the path stands' ->

    assert.equal render.abbreviateHome('/home/kodi/s/kit', undefined), '/home/kodi/s/kit'
    assert.equal render.abbreviateHome('/home/kodi/s/kit', ''), '/home/kodi/s/kit'

test 'renderTracking: in-sync renders empty' ->

    assert.equal render.renderTracking({ahead: 0, behind: 0}, {theme: style.plainTheme}), ''
    assert.match render.renderTracking({ahead: 3, behind: 1}, {theme: style.plainTheme}), /↑3\x20↓1/

###
 ███████   ███████   ██     ██  ██     ██  ███  █████████  █████████  ████████  ███████          ███   ███  ███  ████████  ███   ███
███       ███   ███  ███   ███  ███   ███  ███     ███        ███     ███       ███   ███        ███   ███  ███  ███       ███ █ ███
███       ███   ███  █████████  █████████  ███     ███        ███     ███████   ███   ███         ███ ███   ███  ███████   █████████
███       ███   ███  ███ █ ███  ███ █ ███  ███     ███        ███     ███       ███   ███           ███     ███  ███       ███   ███
 ███████   ███████   ███   ███  ███   ███  ███     ███        ███     ████████  ███████              █      ███  ████████  ██     ██
###

#  committed view (kit commit's pre-commit status)
#
#  `kit commit` renders the state it is about to commit. That snapshot is
#  exactly the commit's contents, so the heading says "committed" rather than
#  "staged", and the status letters are lowercased so the meaning survives
#  skipping the heading. Uppercase is kept everywhere else.

mixedTree = ->
    branch: 'main'
    ahead: 0
    behind: 0
    detached: false
    staged: [{path: 'lib/add.mjs', code: 'A'}, {path: 'README.md', code: 'M'}]
    unstaged: [{path: '../kit.md', code: 'M'}]
    untracked: [{path: 'notes.tmp', code: '?'}]

test 'renderStatus: committed view renames the staged heading' ->

    out = render.renderStatus mixedTree(), {committed: true, theme: style.plainTheme}

    assert.match out, style.headingOf('committed'), 'staged heading becomes committed'
    assert.doesNotMatch out, style.headingOf('staged'), 'staged heading is gone'
    assert.match out, style.headingOf('unstaged'), 'unstaged is untouched'
    assert.match out, style.headingOf('untracked'), 'untracked is untouched'

test 'renderStatus: default view still says staged' ->

    out = render.renderStatus mixedTree(), {theme: style.plainTheme}

    assert.match out, style.headingOf('staged')
    assert.doesNotMatch out, /committed/

test 'renderStatus: committed view lowercases letters in that section only' ->

    out = render.renderStatus mixedTree(), {committed: true, theme: style.plainTheme}

    assert.match out, /a\x20lib\/add\.mjs/
    assert.match out, /m\x20README\.md/
    assert.match out, /M\x20\.\.\/kit\.md/

test 'renderStatus: deletion letter is lowercased in the committed view' ->

    d = branch: 'main', staged: [{path: 'old.sh', code: 'D'}], unstaged: [], untracked: []

    out = render.renderStatus d, Object.assign({}, {committed: true}, {theme: style.plainTheme})

    assert.match out, /d\x20old\.sh/

test 'renderStatus: committed view keeps untracked question mark' ->

    out = render.renderStatus mixedTree(), {committed: true, theme: style.plainTheme}

    assert.match out, /\?\x20notes\.tmp/, 'the ? marker is unchanged'

test 'renderStatus: a file in both committed and unstaged renders in both' ->

    #  Not a bug: a file staged, then modified again, is in the commit *and*
    #  still has loose changes in the tree.

    d =
        branch: 'main'
        staged: [{path: 'a.mjs', code: 'M'}]
        unstaged: [{path: 'a.mjs', code: 'M'}]
        untracked: []

    out = render.renderStatus d, Object.assign({}, {committed: true}, {theme: style.plainTheme})

    assert.match out, /m\x20a\.mjs/, 'lowercase under committed'
    assert.match out, /M\x20a\.mjs/, 'uppercase under unstaged'
    assert.equal out.match(/a\.mjs/g).length, 2, 'listed exactly twice'

test 'renderStatus: committed view on a clean tree still renders nothing' ->

    d = branch: 'main', staged: [], unstaged: [], untracked: []

    out = render.renderStatus d, Object.assign({}, {committed: true}, {theme: style.plainTheme})

    assert.equal out, ''

test 'renderStatus: the heading column stays aligned across the groups' ->

    heads = style.headingLines render.renderStatus(mixedTree(), {committed: true, theme: style.plainTheme})

    assert.equal heads.length, 3

    widths = new Set
    for l in heads
        widths.add render.displayWidth(style.plain(l))

    assert.equal widths.size, 1, 'all three headings same width'

test 'renderStatus: every group carries a marker, and all of one width' ->

    heads = style.headingLines render.renderStatus(mixedTree(), {theme: style.plainTheme})

    assert.equal heads.length, 3

    offsets = new Set
    for l in heads
        word = l.trim().split(/\s+/).pop()
        offsets.add render.displayWidth(style.plain(l).trimEnd()) - render.displayWidth(word)

    assert.equal offsets.size, 1, 'every group marker is the same width'
    assert.ok Array.from(offsets)[0] >= 2, 'and it displaces at least a marker and a space'

test 'renderStatus: entries sit under their heading, whatever the marker is' ->

    out = render.renderStatus mixedTree(), {theme: style.plainTheme}
    head = style.headingLines(out)[0]
    word = head.trim().split(/\s+/).pop()
    wordColumn = render.displayWidth(style.plain(head).trimEnd()) - render.displayWidth(word)
    indent = ' '.repeat wordColumn

    entries = style.plain(out).split('\n').filter (l) -> (/^\s+\S/).test l

    assert.equal entries.length, 4, 'two staged, one unstaged, one untracked'

    for line in entries
        assert.ok line.startsWith(indent), "\"#{line}\" should be indented by #{wordColumn}"

test 'renderCommitSuccess: keeps branch, hash, subject and stat; drops noise' ->

    stdout = [
        '[master e3cd348] fourth'
        ' Author: someone <s@e.st>'
        ' 1 file changed, 1 insertion(+)'
        ' create mode 100644 new.txt'
        ' delete mode 100644 old.txt'
        ].join('\n')

    out = render.renderCommitSuccess stdout, {theme: style.plainTheme}

    assert.match out, /\[master\x20e3cd348\]\x20fourth/
    assert.match out, /1\x20file\x20changed,\x201\x20insertion/
    assert.doesNotMatch out, /Author:/, 'author line is noise for a single-user repo'
    assert.doesNotMatch out, /create\x20mode|delete\x20mode/, 'modes duplicate the status tree'

test 'renderCommitSuccess: no trailing blank lines' ->

    out = render.renderCommitSuccess('[main abc1234] msg\n 1 file changed\n\n\n', {theme: style.plainTheme})

    assert.equal out.split('\n').length, 2

test 'renderCommitFailure: extracts only the concluding line, drops hint' ->

    stdout = [
        'On branch master'
        'Untracked files:'
        '  (use "git add <file>..." to include in what will be committed)'
        '\tnew.txt'
        ''
        'nothing added to commit but untracked files present (use "git add" to track)'
        ].join('\n')

    out = render.renderCommitFailure stdout, {theme: style.plainTheme}

    assert.equal out, 'nothing added to commit but untracked files present'
    assert.doesNotMatch out, /On\x20branch/
    assert.doesNotMatch out, /new\.txt/

test 'renderCommitFailure: clean tree renders nothing' ->

    out = render.renderCommitFailure 'On branch master\nnothing to commit, working tree clean', {theme: style.plainTheme}

    assert.equal out, ''

test 'renderCommitFailure: unknown output is passed through, not swallowed' ->

    out = render.renderCommitFailure 'something unexpected happened', {theme: style.plainTheme}

    assert.equal out, 'something unexpected happened'

test 'renderCommitFailure: handles a message with no trailing hint' ->

    out = render.renderCommitFailure 'On branch master\nnothing added to commit but untracked files present'

    assert.equal out, 'nothing added to commit but untracked files present'