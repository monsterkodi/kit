###
███       ███████    ███████
███      ███   ███  ███
███      ███   ███  ███  ████
███      ███   ███  ███   ███
███████   ███████    ███████
###

#  `kit log` parsing and rendering.

import test from 'node:test'
import assert from 'node:assert/strict'

use ../git
use ../render
use ../theme
use ./style

#  One record exactly as git writes it for --format=%x00%h%x00%ad%x00%an%x00%s%x00:

record = (h, d, n, s) -> "\0#{h}\0#{d}\0#{n}\0#{s}\0\n"

test 'parseLog: reads one record per line' ->

    first = record('41f3542', 'Oct  1 23:53', 'Thorsten', 'a message')
    second = record('3421d42', 'Oct  1 23:49', 'Thorsten', 'another')
    raw = first + second

    assert.deepEqual git.parseLog(raw), [
        {hash: '41f3542', date: 'Oct  1 23:53', name: 'Thorsten', subject: 'a message', body: 'a message'}
        {hash: '3421d42', date: 'Oct  1 23:49', name: 'Thorsten', subject: 'another', body: 'another'}
    ]

test 'parseLog: no trailing newline on the last record' ->

    raw = record('aaa1111', 'Oct  1 23:53', 'Thorsten', 'only one').replace(/\n$/, '')
    out = git.parseLog raw

    assert.equal out.length, 1
    assert.equal out[0].subject, 'only one'

test 'parseLog: empty input yields nothing' ->

    assert.deepEqual git.parseLog(''), []
    assert.deepEqual git.parseLog('\n'), []

test 'parseLog: subject containing spaces and colons survives intact' ->

    subject = 'fix: handle empty tree and  spaces'
    out = git.parseLog record('abc1234', 'Oct  1 23:53', 'Thorsten', subject)

    assert.equal out[0].subject, subject

test 'parseLog: unicode author and subject survive' ->

    out = git.parseLog record('abc1234', 'Jun 15 14:30', 'Zoë Müller', 'ünïcödé ✓')

    assert.equal out[0].name, 'Zoë Müller'
    assert.equal out[0].subject, 'ünïcödé ✓'

test 'parseLog: no newline leaks into the next record hash' ->

    first = record('aaa1111', 'Oct  1 23:53', 'Thorsten', 'first')
    second = record('bbb2222', 'Oct  1 23:52', 'Thorsten', 'second')
    raw = first + second

    for c in git.parseLog(raw)
        assert.ok not c.hash.includes('\n'), 'hash must not contain a newline'
        assert.ok not c.date.includes('\n')
        assert.ok not c.name.includes('\n')

test 'parseLog: a multi-line %B body stays with its own record' ->

    body = 'subject\n\nbody para one\nbody para one b\n\npara two'

    first = record('aaa1111', 'Oct  1 23:53', 'Thorsten', body)
    second = record('bbb2222', 'Oct  1 23:52', 'Thorsten', 'second')
    raw = first + second

    out = git.parseLog raw

    assert.equal out.length, 2, 'both records survive'
    assert.equal out[0].subject, body, 'the body keeps its newlines and blank lines'
    assert.equal out[1].subject, 'second', 'the following record is not polluted'

test 'parseLog: a body containing a record separator does not break parsing' ->

    body = 'subject\n\nbody with \x1e inside'

    first = record('aaa1111', 'Oct  1 23:53', 'Thorsten', body)
    second = record('bbb2222', 'Oct  1 23:52', 'Thorsten', 'second')
    raw = first + second

    out = git.parseLog raw

    assert.equal out.length, 2
    assert.ok out[0].subject.includes '\x1e'

test 'fitName: pads to exactly 8 characters' ->

    assert.equal render.NAME_WIDTH, 8
    assert.equal render.fitName('Thorsten'), 'Thorsten'
    assert.equal render.fitName('opencode'), 'opencode'
    assert.equal render.fitName('zoe'), 'zoe     '
    assert.equal render.fitName('zoe').length, 8

test 'fitName: crops names longer than 8' ->

    assert.equal render.fitName('Christopher'), 'Christop'
    assert.equal render.fitName('Thorsten Kohnhorst'), 'Thorsten'

test 'fitName: handles empty and missing names' ->

    assert.equal render.fitName(''), '        '
    assert.equal render.fitName(undefined), '        '

commit = (over={}) ->

    base =
        hash: 'abc1234'
        date: 'Oct  1 23:53'
        name: 'Thorsten'
        subject: 'a message'

    Object.assign base, over

test 'renderLog: one line per commit' ->

    out = render.renderLog([commit(), commit({hash: 'def5678', subject: 'another'})], {theme: style.plainTheme})

    assert.equal out.split('\n').length, 2

test 'renderLog: empty history renders nothing' ->

    assert.equal render.renderLog([], {theme: style.plainTheme}), ''
    assert.equal render.renderLog(null, {theme: style.plainTheme}), ''

test 'renderLog: fields appear in order' ->

    out = render.renderLog([commit()], {theme: style.plainTheme})

    assert.equal out, 'abc1234 Oct  1 23:53 Thorsten a message'

test 'renderLog: subject column aligns across rows regardless of name length' ->

    out = render.renderLog [
        commit({name: 'Thorsten', subject: 'long-ish subject'})
        commit({name: 'zoe', subject: 'x'})
    ], {theme: style.plainTheme}

    positions = out.split('\n').map((l) -> if l.indexOf('x') >= 0 then l.indexOf('x') else -1)
    firstSubject = out.split('\n')[0].indexOf 'long-ish subject'

    assert.equal positions[1], firstSubject

test 'renderLog: colours each column differently' ->

    out = render.renderLog([commit()], {theme: theme.createTheme(true)})

    codes = out.match(/\u001b\[38;5;\d+m/g).map((s) -> s.match(/\d+(?=m$)/)[0])

    assert.deepEqual codes, ['245' '39' '41'], 'grey hash, blue date, green name'

test 'renderLog: the same commit rendered plain has no escapes at all' ->

    out = render.renderLog([commit()], {theme: theme.createTheme(false)})

    assert.doesNotMatch out, /\u001b\[/, 'a plain palette emits nothing'
    assert.match out, /a\x20message/, 'and the subject is still there'

test 'renderLog: subject is never truncated or recoloured' ->

    subject = 'fix: a long subject line that should be left completely alone'
    out = render.renderLog([commit({subject})], {width: 200})

    assert.ok out.endsWith(subject), 'subject reaches the end of the line verbatim'

dated = (dates...) ->

    dates.map (date, i) -> commit({hash: 'abc1234', date, subject: "m#{i}"})

test 'collapseDates: the first date is always written out in full' ->

    assert.deepEqual render.collapseDates(dated('Nov  9 00:00')), ['Nov  9 00:00']

test 'collapseDates: a repeated day keeps only its time' ->

    out = render.collapseDates dated('Oct  1 14:00', 'Oct  1 15:00')

    assert.deepEqual out, ['Oct  1 14:00', '       15:00']

test 'collapseDates: the same month on another day blanks the month alone' ->

    out = render.collapseDates dated('Oct  1 14:00', 'Oct  5 00:01')

    assert.deepEqual out, ['Oct  1 14:00', '     5 00:01']

test 'collapseDates: a new month is written out in full again' ->

    out = render.collapseDates dated('Oct  9 12:00', 'Nov  9 00:00')

    assert.deepEqual out, ['Oct  9 12:00', 'Nov  9 00:00'], 'the shared day 9 is not enough to carry the date forward'

test 'collapseDates: a repeated day number is kept whole, not cut into the digits' ->

    out = render.collapseDates dated('Nov  9 00:00', 'Nov 10 10:10', 'Nov 13 12:11')

    assert.deepEqual out, ['Nov  9 00:00', '    10 10:10', '    13 12:11']

test 'collapseDates: the comparison is against the date above, not the line as printed' ->

    out = render.collapseDates dated('Oct  1 14:00', 'Oct  1 15:00', 'Oct  2 09:30')

    assert.deepEqual out, ['Oct  1 14:00', '       15:00', '     2 09:30']

test 'collapseDates: blanking is only ever spaces, so the width never moves' ->

    raw = ['Oct  1 14:00', 'Oct  5 00:01', 'Nov  9 00:00', 'Nov 10 10:10']

    out = render.collapseDates dated.apply(null, raw)

    entries = out.entries()

    for e in entries
        assert.equal e[1].length, raw[e[0]].length

test 'collapseDates: a run of commits across months and days' ->

    out = render.collapseDates dated(
        'Oct  1 14:00'
        'Oct  1 15:00'
        'Oct  5 00:01'
        'Oct  5 12:13'
        'Oct  6 12:00'
        'Oct  9 12:00'
        'Nov  9 00:00'
        'Nov 10 10:10'
        'Nov 13 12:11'
    )

    assert.deepEqual out, [
        'Oct  1 14:00'
        '       15:00'
        '     5 00:01'
        '       12:13'
        '     6 12:00'
        '     9 12:00'
        'Nov  9 00:00'
        '    10 10:10'
        '    13 12:11'
    ]

test 'renderLog: a repeated date is blanked on the line below' ->

    out = render.renderLog(dated('Oct  1 14:00', 'Oct  1 15:00'), {theme: style.plainTheme})

    assert.equal out.split('\n')[1], 'abc1234        15:00 Thorsten m1'

test 'renderLog: blanking a date leaves the subject column where it was' ->

    out = render.renderLog(dated('Oct  1 14:00', 'Oct  1 15:00', 'Nov  9 00:00'), {theme: style.plainTheme})

    columns = out.split('\n').map((l) -> l.indexOf 'Thorsten')

    assert.equal (new Set(columns)).size, 1, 'every line puts the name in the same column'

test 'renderLog: -l writes every date out in full' ->

    out = render.renderLog(dated('Oct  1 14:00', 'Oct  1 15:00'), {theme: style.plainTheme, long: true})

    assert.equal out.split('\n')[1], 'abc1234 Oct  1 15:00 Thorsten m1'

test 'renderLog: a blanked date is still coloured as one column' ->

    out = render.renderLog(dated('Oct  1 14:00', 'Oct  1 15:00'), {theme: theme.createTheme(true)})

    codes = out.split('\n')[1].match(/\u001b\[38;5;\d+m/g).map((s) -> s.match(/\d+(?=m$)/)[0])

    assert.deepEqual codes, ['245' '39' '41'], 'grey hash, blue date, green name'

test 'renderLog: the narrow layout blanks a repeated date too' ->

    out = render.renderLog(dated('Oct  1 14:00', 'Oct  1 15:00'), {theme: style.plainTheme, width: 50})

    assert.match out.split('\n')[2], /^abc1234\x20{8}15:00\x20Thorsten$/, 'the date is blanked, the time is not'